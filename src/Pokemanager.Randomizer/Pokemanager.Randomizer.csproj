<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pokemanager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pokemanager.Model\Pokemanager.Model.csproj" />
  </ItemGroup>

  <!-- Java launcher and bundled tools (tools/upr/PokeRandoZX.jar): copied to the output of any project using this one. -->
  <ItemGroup>
    <None Include="upr\PokemanagerUpr.java" CopyToOutputDirectory="PreserveNewest" LinkBase="upr" />
    <None Include="..\..\tools\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="tools" />
  </ItemGroup>

  <!-- User-facing text, including the option catalog: English by default, Spanish in Strings.es.resx. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Pokemanager.Randomizer.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
