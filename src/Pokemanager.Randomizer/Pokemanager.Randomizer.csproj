<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pokemanager.Tests" />
  </ItemGroup>

  <!-- Lanzador Java y herramientas incluidas (tools/upr/PokeRandoZX.jar): viajan con cualquier proyecto que use este. -->
  <ItemGroup>
    <None Include="upr\PokemanagerUpr.java" CopyToOutputDirectory="PreserveNewest" LinkBase="upr" />
    <None Include="..\..\tools\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="tools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pokemanager.Model\Pokemanager.Model.csproj" />
  </ItemGroup>

</Project>
