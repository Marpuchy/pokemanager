<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             xmlns:views="using:Pokemanager.App.Views"
             x:Class="Pokemanager.App.App"
             RequestedThemeVariant="Light">

  <Application.DataTemplates>
    <DataTemplate DataType="vm:WelcomeViewModel">
      <views:WelcomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:EditorViewModel">
      <views:EditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:RandomizerViewModel">
      <views:RandomizerView />
    </DataTemplate>
    <DataTemplate DataType="vm:SaveEditorViewModel">
      <views:SaveEditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel">
      <views:HistoryView />
    </DataTemplate>
    <DataTemplate DataType="vm:LockeViewModel">
      <views:LockeView />
    </DataTemplate>
    <DataTemplate DataType="vm:RoomViewModel">
      <views:RoomView />
    </DataTemplate>
    <!-- Profile picture of a player: image, trainer sprite or initials on the accent color -->
    <DataTemplate DataType="vm:AvatarViewModel">
      <Border Background="{Binding Accent}" CornerRadius="999" ClipToBounds="True">
        <Panel>
          <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasImage}" />
          <Border Background="#F0FFFFFF" Margin="2" CornerRadius="999" ClipToBounds="True" IsVisible="{Binding HasImage}">
            <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
          </Border>
        </Panel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:TypeChip">
      <Border Background="{Binding Background}" BorderBrush="#60000000" BorderThickness="1" CornerRadius="3" Padding="5,0">
        <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="10" FontWeight="SemiBold" />
      </Border>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://Pokemanager.App/Styles/ClassicTheme.axaml" />

    <!-- Group boxes of the responsive pages (WinForms GroupBox look) -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D5DFE5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="10,6,10,8" />
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1C3A70" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Pixel-art sprites: scale without blurring -->
    <Style Selector="Image.sprite">
      <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!-- Field whose value differs from the base -->
    <Style Selector="TextBlock.field-label.modified">
      <Setter Property="Foreground" Value="#E07B00" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1C3A70" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBlock.dot">
      <Setter Property="Foreground" Value="#E07B00" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#D13438" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#6D6D6D" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.hint.current">
      <Setter Property="Foreground" Value="#2E8B57" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </Application.Styles>
</Application>
