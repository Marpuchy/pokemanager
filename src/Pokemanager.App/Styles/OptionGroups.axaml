<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pokemanager.App.ViewModels"
        xmlns:r="using:Pokemanager.App.Resources"
        xmlns:c="using:Pokemanager.App.Controls">
  <!--
    One theme page per subject (2026-11-09, user chose "by subject"): each subject's tab shows the randomizer's options
    of its groups (Aleatorio) and this application's own cards for the same subject (Ajustes). These are the two halves
    of what used to be one page per option group, so both are drawn from the group view model wherever they appear.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <!-- The randomizer's options of one group, in columns across the width -->
      <!-- One option of the randomizer: a switch, a list or a number -->
      <DataTemplate x:Key="UprOption" x:DataType="vm:UprOptionViewModel">
        <StackPanel Margin="0,3" Spacing="2" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Tip}">
          <CheckBox IsVisible="{Binding IsBool}" IsChecked="{Binding BoolValue}">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock IsVisible="{Binding !IsBool}" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding ChoiceLabels}" SelectedIndex="{Binding ChoiceIndex}"
                    HorizontalAlignment="Stretch" MaxDropDownHeight="400" />
          <NumericUpDown IsVisible="{Binding IsInt}" Value="{Binding IntValue}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                         Increment="1" FormatString="0" ParsingNumberStyle="Integer" Width="150" HorizontalAlignment="Left" />
        </StackPanel>
      </DataTemplate>

      <!-- Titled cards of randomizer options, in balanced columns -->
      <DataTemplate x:Key="UprSectionCard" x:DataType="vm:UprOptionSectionViewModel">
        <Border Classes="card" Margin="0,0,0,12" VerticalAlignment="Top">
          <StackPanel Spacing="2">
            <TextBlock Classes="card-title" Text="{Binding Title}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource UprOption}" />
          </StackPanel>
        </Border>
      </DataTemplate>

      <!-- A group's options grouped in titled cards (groups that have sections) -->
      <DataTemplate x:Key="UprGroupSections" x:DataType="vm:UprOptionGroupViewModel">
        <ItemsControl Margin="16,10,16,0" ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource UprSectionCard}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <c:ColumnFlowPanel MinColumnWidth="340" MaxColumns="3" ColumnSpacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </DataTemplate>

      <DataTemplate x:Key="UprGroupOptions" x:DataType="vm:UprOptionGroupViewModel">
    <ItemsControl Margin="16,10,16,10" ItemsSource="{Binding Items}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <c:ColumnFlowPanel MinColumnWidth="300" MaxColumns="4" ColumnSpacing="28" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:UprOptionViewModel">
          <StackPanel Margin="0,3" Spacing="2" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Tip}">
            <CheckBox IsVisible="{Binding IsBool}" IsChecked="{Binding BoolValue}">
              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock IsVisible="{Binding !IsBool}" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding ChoiceLabels}" SelectedIndex="{Binding ChoiceIndex}"
                      HorizontalAlignment="Stretch" MaxDropDownHeight="400" />
            <NumericUpDown IsVisible="{Binding IsInt}" Value="{Binding IntValue}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                           Increment="1" FormatString="0" ParsingNumberStyle="Integer" Width="150" HorizontalAlignment="Left" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
      </DataTemplate>

      <!-- This application's cards for the subject of one group (each card shows itself only on its group) -->
      <DataTemplate x:Key="UprGroupOurs" x:DataType="vm:UprOptionGroupViewModel">
    <WrapPanel Margin="16,0,4,2">
      <WrapPanel.Styles>
        <!-- Cards side by side: the same 12 px gap as the randomizer's columns -->
        <Style Selector="WrapPanel > Border.card">
          <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
      </WrapPanel.Styles>
      <!-- Items and shops -->
      <Border Classes="card" Width="470" IsVisible="{Binding HasShops}">
       <StackPanel DataContext="{Binding Shops}" x:DataType="vm:ShopExtrasViewModel">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="{x:Static r:Strings.Shops_BuildTitle}" />
          <CheckBox Margin="0,3" IsChecked="{Binding FreeRareCandies}" IsEnabled="{Binding Supported}"
                    ToolTip.Tip="{Binding FreeRareCandiesTip}">
            <TextBlock Text="{x:Static r:Strings.Shops_FreeCandies}" TextWrapping="Wrap" />
          </CheckBox>
          <CheckBox Margin="0,3" IsChecked="{Binding MegaStonesOnSale}" IsEnabled="{Binding Supported}"
                    IsVisible="{Binding HasMegaStones}" ToolTip.Tip="{x:Static r:Strings.Shops_MegaStonesOnSaleTip}">
            <TextBlock Text="{Binding MegaStonesOnSaleText}" TextWrapping="Wrap" />
          </CheckBox>
        </StackPanel>
       </StackPanel>
      </Border>

      <!-- Trainers: the options that come once per kind of trainer, as one table -->
      <Border Classes="card" Width="760" IsVisible="{Binding HasKindTable}">
        <StackPanel Spacing="4" DataContext="{Binding KindTable}" x:DataType="vm:TrainerKindTableViewModel">
          <TextBlock Classes="card-title" Text="{x:Static r:Strings.TrainerKinds_Title}" />
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.TrainerKinds_Hint}" />
          <Grid ColumnDefinitions="180,*,*,*" Margin="0,6,0,2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static r:Strings.TrainerKinds_Option}" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Static vm:TrainerKindTableViewModel.RegularHeader}" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{x:Static vm:TrainerKindTableViewModel.ImportantHeader}" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{x:Static vm:TrainerKindTableViewModel.BossHeader}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TrainerKindRowViewModel">
                <Border Classes="info-row">
                  <Grid ColumnDefinitions="180,*,*,*" MinHeight="28" ToolTip.Tip="{Binding Tip}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      <TextBlock Classes="hint" FontSize="11" Text="{x:Static r:Strings.TrainerKinds_Ours}" IsVisible="{Binding IsOurs}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <ContentControl Grid.Column="1" Content="{Binding Regular}" VerticalAlignment="Center" />
                    <ContentControl Grid.Column="2" Content="{Binding Important}" VerticalAlignment="Center" />
                    <ContentControl Grid.Column="3" Content="{Binding Boss}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="vm:TrainerKindCellViewModel">
                <Panel>
                  <CheckBox IsVisible="{Binding IsSwitch}" IsChecked="{Binding Option.BoolValue}" IsEnabled="{Binding Option.IsEnabled}" />
                  <NumericUpDown IsVisible="{Binding IsNumber}" Value="{Binding Option.IntValue}" Minimum="{Binding Option.Min}"
                                 Maximum="{Binding Option.Max}" Increment="1" FormatString="0" ParsingNumberStyle="Integer"
                                 Width="116" HorizontalAlignment="Left" IsEnabled="{Binding Option.IsEnabled}" />
                  <StackPanel IsVisible="{Binding IsMegaCell}" Orientation="Horizontal" Spacing="6">
                    <CheckBox IsChecked="{Binding Items.Mega}" VerticalAlignment="Center" />
                    <NumericUpDown Width="116" Value="{Binding Items.MegaFromLevel}" Minimum="1" Maximum="100" Increment="1"
                                   FormatString="0" ParsingNumberStyle="Integer" IsEnabled="{Binding Items.Mega}" />
                  </StackPanel>
                  <StackPanel IsVisible="{Binding IsZCell}" Orientation="Horizontal" Spacing="6">
                    <CheckBox IsChecked="{Binding Items.Z}" VerticalAlignment="Center" />
                    <NumericUpDown Width="116" Value="{Binding Items.ZFromLevel}" Minimum="1" Maximum="100" Increment="1"
                                   FormatString="0" ParsingNumberStyle="Integer" IsEnabled="{Binding Items.Z}" />
                  </StackPanel>
                </Panel>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Trainers: the difficulty of the run, which writes over every trainer -->
      <Border Classes="card" Width="470" IsVisible="{Binding HasDifficulty}">
        <StackPanel Spacing="4" DataContext="{Binding Difficulty}" x:DataType="vm:DifficultyViewModel"
                    ToolTip.Tip="{x:Static r:Strings.Tip_Difficulty}">
          <TextBlock Classes="card-title" Text="{x:Static r:Strings.Difficulty_Title}" />
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Difficulty_Hint}" />
          <TextBlock Text="{Binding Applied}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
          <ListBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Selected}" MaxHeight="230">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DifficultyOptionViewModel">
                <StackPanel Spacing="1" Margin="0,2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding About}" Classes="hint" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding Selected.Detail}" TextWrapping="Wrap" Margin="0,2" />
          <Button Content="{x:Static r:Strings.Difficulty_Apply}" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Classes="hint" />
        </StackPanel>
      </Border>

      <!-- Trainers: their levels and what they pay (2026-11-09, user: the trainer level % lives with the trainers) -->
      <Border Classes="card" Width="470" IsVisible="{Binding IsTrainers}">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="{x:Static r:Strings.Options_TrainerMoney}" />
          <Grid ColumnDefinitions="200,Auto" Margin="0,2">
            <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Options_TrainerLevelRow}" />
            <NumericUpDown Grid.Column="1" Width="110" Value="{Binding Game.TrainerLevelPercent}" Minimum="-90" Maximum="400"
                           Increment="5" FormatString="0.##" ToolTip.Tip="{x:Static r:Strings.Tip_GameLevelsTrainers}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding Game.HasPresetTrainerLevel}">
            <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Text="{Binding Game.PresetTrainerLevelText}" />
            <Button Content="{x:Static r:Strings.Options_ClearPreset}" Command="{Binding Game.ClearPresetTrainerLevelCommand}" />
          </StackPanel>
          <Grid ColumnDefinitions="200,Auto" Margin="0,2">
            <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_Money}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="110" Value="{Binding Game.MoneyPercent}" Minimum="1" Maximum="1000" Increment="5"
                             FormatString="0" ParsingNumberStyle="Integer" />
              <Button Content="{x:Static r:Strings.Game_Apply}" Command="{Binding Game.ApplyMoneyCommand}" />
              <Button Content="{x:Static r:Strings.Game_Reset}" Command="{Binding Game.ResetCommand}" CommandParameter="money"
                      ToolTip.Tip="{x:Static r:Strings.Game_ResetTip}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding Game.Result}" FontWeight="SemiBold"
                     IsVisible="{Binding Game.Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- Levels: the level cap by milestones, with its plan -->
      <Border Classes="card" Width="470" IsVisible="{Binding IsLevels}">
        <Border.Styles>
          <Style Selector="Border.current">
            <Setter Property="Background" Value="#E8F1FB" />
          </Style>
          <Style Selector="Border.current TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </Border.Styles>
        <StackPanel Spacing="4" DataContext="{Binding Game.LevelCap}" x:DataType="vm:LevelCapViewModel">
          <TextBlock Classes="card-title" Text="{x:Static r:Strings.LevelCap_Title}" />
          <CheckBox IsChecked="{Binding Enabled}" IsEnabled="{Binding Supported}" ToolTip.Tip="{Binding EnabledTip}"
                    Content="{x:Static r:Strings.LevelCap_Enable}" />
          <CheckBox IsChecked="{Binding TrimOverCap}" IsVisible="{Binding Enabled}" ToolTip.Tip="{x:Static r:Strings.Tip_LevelCapTrim}"
                    Content="{x:Static r:Strings.LevelCap_TrimEnable}" />
          <TextBlock Text="{Binding CurrentText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding Enabled}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LevelCapStepViewModel">
                <Border Classes="info-row" Classes.current="{Binding IsCurrent}" Padding="4,1">
                  <Grid ColumnDefinitions="24,*,90,Auto">
                    <Image Source="{Binding Icon}" Width="20" Height="20" IsVisible="{Binding HasIcon}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" />
                    <NumericUpDown Grid.Column="2" Value="{Binding Level}" Minimum="1" Maximum="100" Increment="1" FormatString="0"
                                   ParsingNumberStyle="Integer" ToolTip.Tip="{Binding Tip}" />
                    <TextBlock Grid.Column="3" Margin="8,0,0,0" MinWidth="60" VerticalAlignment="Center" Text="{Binding State}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Levels: one value for the whole game, then each kind apart -->
      <Border Classes="card" Width="470" IsVisible="{Binding IsLevels}">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="{x:Static r:Strings.Options_LevelsTitle}" />
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Game_LevelsHint}" />
          <Grid ColumnDefinitions="200,Auto" Margin="0,4,0,6">
            <TextBlock Classes="row-label" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Static r:Strings.Options_LevelsGlobal}" />
            <NumericUpDown Grid.Column="1" Width="130" Value="{Binding Game.AllLevelPercent}" Minimum="-90" Maximum="400"
                           Increment="5" FormatString="0.##" ToolTip.Tip="{x:Static r:Strings.Tip_LevelsGlobal}" />
          </Grid>
          <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding Game.AllLevelsMixed}"
                     Text="{x:Static r:Strings.Options_LevelsMixed}" />
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Options_LevelsWhere}" />
        </StackPanel>
      </Border>

      <!-- The personal table of every Pokemon of the game, in one go -->
      <Border Classes="card" Width="470" IsVisible="{Binding IsPokemon}">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="{x:Static r:Strings.Game_SweepsTitle}" />
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Game_SweepsHint}" />
          <Grid ColumnDefinitions="180,Auto" Margin="0,2">
            <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_Experience}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="110" Value="{Binding Game.ExperiencePercent}" Minimum="1" Maximum="1000" Increment="5" FormatString="0" ParsingNumberStyle="Integer" />
              <Button Content="{x:Static r:Strings.Game_Apply}" Command="{Binding Game.ApplyExperienceCommand}" />
              <Button Content="{x:Static r:Strings.Game_Reset}" Command="{Binding Game.ResetCommand}" CommandParameter="baseExp" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="180,Auto" Margin="0,2">
            <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_CatchRate}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="110" Value="{Binding Game.CatchRatePercent}" Minimum="1" Maximum="1000" Increment="5" FormatString="0" ParsingNumberStyle="Integer" />
              <Button Content="{x:Static r:Strings.Game_Apply}" Command="{Binding Game.ApplyCatchRateCommand}" />
              <Button Content="{x:Static r:Strings.Game_Reset}" Command="{Binding Game.ResetCommand}" CommandParameter="catchRate" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="180,Auto" Margin="0,2">
            <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_Hatch}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="110" Value="{Binding Game.HatchPercent}" Minimum="1" Maximum="1000" Increment="5" FormatString="0" ParsingNumberStyle="Integer" />
              <Button Content="{x:Static r:Strings.Game_Apply}" Command="{Binding Game.ApplyHatchCommand}" />
              <Button Content="{x:Static r:Strings.Game_Reset}" Command="{Binding Game.ResetCommand}" CommandParameter="hatchCycles" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="180,Auto" Margin="0,2">
            <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_Friendship}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="110" Value="{Binding Game.FriendshipValue}" Minimum="0" Maximum="255" Increment="5" FormatString="0" ParsingNumberStyle="Integer" />
              <Button Content="{x:Static r:Strings.Game_Apply}" Command="{Binding Game.ApplyFriendshipCommand}" />
              <Button Content="{x:Static r:Strings.Game_Reset}" Command="{Binding Game.ResetCommand}" CommandParameter="baseFriendship" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding Game.Result}" FontWeight="SemiBold"
                     IsVisible="{Binding Game.Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- The whole game: shiny -->
      <Border Classes="card" Width="470" IsVisible="{Binding IsMisc}">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="{x:Static r:Strings.Game_ShinyTitle}" />
          <Grid ColumnDefinitions="200,Auto" Margin="0,2" IsEnabled="{Binding Game.ShinySupported}" ToolTip.Tip="{Binding Game.ShinyTip}">
            <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_ShinyOdds}" />
            <NumericUpDown Grid.Column="1" Width="130" Value="{Binding Game.ShinyOdds}" Minimum="1" Maximum="4096"
                           Increment="1" FormatString="0" ParsingNumberStyle="Integer" />
          </Grid>
          <TextBlock Text="{Binding Game.ShinyOddsText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <WrapPanel IsEnabled="{Binding Game.ShinySupported}">
            <Button Margin="0,0,6,6" Content="{x:Static r:Strings.Game_ShinyPresetGame}" Command="{Binding Game.SetShinyOddsCommand}" CommandParameter="4096" />
            <Button Margin="0,0,6,6" Content="1/1024" Command="{Binding Game.SetShinyOddsCommand}" CommandParameter="1024"
                    IsEnabled="{Binding Game.ShinyRollsSupported}" />
            <Button Margin="0,0,6,6" Content="1/256" Command="{Binding Game.SetShinyOddsCommand}" CommandParameter="256"
                    IsEnabled="{Binding Game.ShinyRollsSupported}" />
            <Button Margin="0,0,6,6" Content="1/64" Command="{Binding Game.SetShinyOddsCommand}" CommandParameter="64"
                    IsEnabled="{Binding Game.ShinyRollsSupported}" />
            <Button Margin="0,0,6,6" Content="{x:Static r:Strings.Game_ShinyPresetAll}" Command="{Binding Game.SetShinyOddsCommand}" CommandParameter="1" />
          </WrapPanel>
        </StackPanel>
      </Border>

    </WrapPanel>
      </DataTemplate>

      <!-- A subject's randomizer options: one titled block per group, or a note while they load -->
      <DataTemplate x:Key="SubjectRandom" x:DataType="vm:UprSubjectViewModel">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,4,0,14">
            <TextBlock Margin="16,12" Text="{Binding Options.LoadStatus}" TextWrapping="Wrap" IsVisible="{Binding !Options.IsLoaded}" />
            <!-- Every group in cards: one set of columns for all of them -->
            <ItemsControl Margin="16,10,16,0" ItemsSource="{Binding AllSections}" IsVisible="{Binding HasAllSections}">
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="vm:UprOptionSectionViewModel">
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UprSectionCard}" />
                </DataTemplate>
                <!-- Items: what can come up at all (this application's, acts when randomizing): the first card of the flow -->
                <DataTemplate DataType="vm:ShopExtrasViewModel">
                  <Border Classes="card" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="card-title" Text="{x:Static r:Strings.Section_ItemPool}" Margin="0,0,0,4" />
                      <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Section_ItemPoolHint}" />
                      <CheckBox Margin="0,3" IsChecked="{Binding AllowAllItems}" ToolTip.Tip="{x:Static r:Strings.Items_AllowAllTip}">
                        <TextBlock Text="{x:Static r:Strings.Items_AllowAll}" TextWrapping="Wrap" />
                      </CheckBox>
                      <CheckBox Margin="0,3" IsChecked="{Binding MegaStonesInPool}" IsVisible="{Binding HasMegaStones}"
                                ToolTip.Tip="{x:Static r:Strings.Items_MegaStonesTip}">
                        <TextBlock Text="{Binding MegaStonesText}" TextWrapping="Wrap" />
                      </CheckBox>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.DataTemplates>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <c:ColumnFlowPanel MinColumnWidth="340" MaxColumns="3" ColumnSpacing="12" KeepColumnWidth="True" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding !HasAllSections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UprOptionGroupViewModel">
                  <StackPanel>
                    <TextBlock Classes="section" Margin="16,10,16,0" Text="{Binding Name}"
                               IsVisible="{Binding $parent[ItemsControl].((vm:UprSubjectViewModel)DataContext).ShowTitles}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UprGroupOptions}" IsVisible="{Binding !HasSections}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UprGroupSections}" IsVisible="{Binding HasSections}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>

      <!-- A subject's own settings: this application's cards of its groups -->
      <DataTemplate x:Key="SubjectSettings" x:DataType="vm:UprSubjectViewModel">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,10,0,0">
            <TextBlock Margin="16,0,16,8" Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Subject_SettingsHint}" />
            <TextBlock Margin="16,4" Text="{Binding Options.LoadStatus}" TextWrapping="Wrap" IsVisible="{Binding !Options.IsLoaded}" />
            <ItemsControl ItemsSource="{Binding SettingsGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UprOptionGroupViewModel">
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UprGroupOurs}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
