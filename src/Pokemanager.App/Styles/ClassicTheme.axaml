<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Classic desktop look, close to PKHeX (WinForms) and Universal Pokémon Randomizer ZX: light grey window, white tab pages,
    square compact controls with thin grey borders, blue highlight, 12 px Segoe UI and group boxes instead of cards.
    Applied on top of FluentTheme (compact density): only colors, sizes and borders are changed, not behavior.
  -->
  <Styles.Resources>
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />

    <Color x:Key="ClassicWindow">#F0F0F0</Color>
    <SolidColorBrush x:Key="ClassicWindowBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ClassicPageBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ClassicBorderBrush" Color="#ADADAD" />
    <SolidColorBrush x:Key="ClassicLightBorderBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="ClassicInputBorderBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="ClassicButtonBrush" Color="#E1E1E1" />
    <SolidColorBrush x:Key="ClassicHoverBrush" Color="#E5F1FB" />
    <SolidColorBrush x:Key="ClassicPressedBrush" Color="#CCE4F7" />
    <SolidColorBrush x:Key="ClassicAccentBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="ClassicSelectionBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="ClassicDisabledBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="ClassicDisabledTextBrush" Color="#A0A0A0" />
  </Styles.Resources>

  <!-- ============================== Window and text ============================== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource ClassicWindowBrush}" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Verdana, sans-serif" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ============================== Buttons ============================== -->
  <Style Selector="Button, RepeatButton, ToggleButton">
    <Setter Property="Background" Value="{StaticResource ClassicButtonBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicAccentBrush}" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter, RepeatButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicPressedBrush}" />
    <Setter Property="BorderBrush" Value="#005499" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicDisabledBrush}" />
    <Setter Property="BorderBrush" Value="#BFBFBF" />
    <Setter Property="Foreground" Value="{StaticResource ClassicDisabledTextBrush}" />
  </Style>

  <!-- The default action (like a WinForms AcceptButton): same button, blue frame and bold text -->
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicPressedBrush}" />
    <Setter Property="BorderBrush" Value="#005499" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicDisabledBrush}" />
    <Setter Property="BorderBrush" Value="#BFBFBF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource ClassicDisabledTextBrush}" />
  </Style>

  <!-- ============================== Text inputs ============================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicInputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#171717" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource ClassicDisabledBrush}" />
    <Setter Property="BorderBrush" Value="#CCCCCC" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="White" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicInputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Background" Value="#F4F4F4" />
  </Style>
  <!-- A spinner arrow that cannot go further (at the minimum or maximum): same look, only a lighter arrow -->
  <!-- Disabled: Fluent drops the outer border around the arrows, so the box looked cut next to its label -->
  <Style Selector="NumericUpDown:disabled /template/ ButtonSpinner#PART_Spinner">
    <Setter Property="BorderBrush" Value="#BFC5CA" />
    <Setter Property="Background" Value="#F4F4F4" />
  </Style>
  <!-- The text box sits 1 px over the spinner's border (negative margin): transparent, so the border shows -->
  <Style Selector="NumericUpDown:disabled ButtonSpinner TextBox#PART_TextBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown:disabled ButtonSpinner TextBox#PART_TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F4F4F4" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicLightBorderBrush}" />
    <Setter Property="Foreground" Value="#C0C0C0" />
  </Style>
  <Style Selector="ButtonSpinner TextBox#PART_TextBox">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="21" />
    <Setter Property="Background" Value="White" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <Style Selector="ButtonSpinner TextBox#PART_TextBox /template/ Border#PART_BorderElement, ButtonSpinner TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="White" />
  </Style>

  <!-- ============================== Date and time pickers ============================== -->
  <Style Selector="CalendarDatePicker">
    <Setter Property="Height" Value="25" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,0,0,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicInputBorderBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- The calendar button inside the box, as tall as it, instead of sticking out -->
  <Style Selector="CalendarDatePicker /template/ Button#PART_Button">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="23" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Background" Value="#F4F4F4" />
  </Style>
  <!-- Fluent's calendar glyph is drawn for a 24 px tall button and was cut to its "15": hidden, the views draw
       Path.calendar-glyph over the (still clickable) button instead -->
  <Style Selector="CalendarDatePicker /template/ Button#PART_Button > Grid">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Path.calendar-glyph">
    <Setter Property="Data" Value="M1.5,2.5 H12.5 V12.5 H1.5 Z M1.5,5.5 H12.5 M4.5,0.5 V3.5 M9.5,0.5 V3.5 M4,8 H6 M8,8 H10 M4,10.5 H6" />
    <Setter Property="Stroke" Value="#4A5560" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,5,0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,0" />
  </Style>

  <!-- ============================== Scroll bars ============================== -->
  <!-- Always expanded, as classic scroll bars: the thumb reaches the ends and the arrows are visible -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>
  <!-- Single-line text boxes never scroll vertically: with scroll bars always shown, a box 1 px shorter than its text
       (the date picker's) drew a scroll bar over the text. The template binds this attached property, so set it here. -->
  <Style Selector="TextBox[AcceptsReturn=False]">
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>
  <Style Selector="ButtonSpinner TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ============================== Combo boxes ============================== -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicInputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5,2,4,2" />
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="MinHeight" Value="23" />
  </Style>
  <Style Selector="ComboBox /template/ ContentControl#ContentPresenter">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource ClassicHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicAccentBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-within /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{StaticResource ClassicAccentBrush}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource ClassicDisabledBrush}" />
    <Setter Property="BorderBrush" Value="#CCCCCC" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicSelectionBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ============================== Check boxes and radio buttons ============================== -->
  <Style Selector="CheckBox, RadioButton">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="6,0,0,0" />
  </Style>

  <!-- ============================== Lists ============================== -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#828790" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicHoverBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicSelectionBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock, ListBoxItem:selected TextBlock.hint">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ============================== Tabs (WinForms TabControl) ============================== -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="0,2,-1,0" />
    <Setter Property="Background" Value="{StaticResource ClassicWindowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicLightBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="TabItem AccessText, TabItem:selected AccessText">
    <Setter Property="TextDecorations" Value="{x:Null}" />
  </Style>
  <Style Selector="TabItem /template/ Border#PART_SelectedPipe, TabItem:selected /template/ Border#PART_SelectedPipe, TabItem:selected:pointerover /template/ Border#PART_SelectedPipe, TabItem:selected:focus /template/ Border#PART_SelectedPipe">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource ClassicHoverBrush}" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicBorderBrush}" />
    <Setter Property="Margin" Value="0,0,-1,-1" />
    <Setter Property="Padding" Value="10,5,10,6" />
    <Setter Property="ZIndex" Value="1" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="White" />
  </Style>
  <!-- Tab strips never wrap into a second row (Fluent uses a WrapPanel): one row on top, one column on the side -->
  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl[TabStripPlacement=Left]">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.wide-side[TabStripPlacement=Left] TabItem">
    <Setter Property="Width" Value="260" />
  </Style>

  <!-- Side tabs (tab strip on the left): same size selected or not, flush with the page, no jump when selecting -->
  <Style Selector="TabControl[TabStripPlacement=Left] TabItem, TabControl[TabStripPlacement=Left] TabItem:selected">
    <Setter Property="Margin" Value="0,0,-1,2" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="1,1,0,1" />
  </Style>
  <Style Selector="TabControl[TabStripPlacement=Left] TabItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabControl[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="6,6,0,0" />
  </Style>
  <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="Background" Value="{StaticResource ClassicPageBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="6,4,6,0" />
  </Style>

  <!-- Tabs inside a card: flush left, only a rule under the strip, the card's own background -->
  <Style Selector="TabControl.inline /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TabControl.inline /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,8,0,0" />
  </Style>
  <Style Selector="TabControl.inline TabItem">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- ============================== Expander ============================== -->
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
</Styles>
