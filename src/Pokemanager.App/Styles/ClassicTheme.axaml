<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Classic desktop look, close to PKHeX (WinForms) and Universal Pokémon Randomizer ZX: light grey window, white tab pages,
    square compact controls with thin grey borders, blue highlight, 12 px Segoe UI and group boxes instead of cards.
    Applied on top of FluentTheme (compact density): only colors, sizes and borders are changed, not behavior.
  -->
  <Styles.Resources>
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />

    <Color x:Key="ClassicWindow">#F0F0F0</Color>
    <SolidColorBrush x:Key="ClassicWindowBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ClassicPageBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ClassicBorderBrush" Color="#ADADAD" />
    <SolidColorBrush x:Key="ClassicLightBorderBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="ClassicInputBorderBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="ClassicButtonBrush" Color="#E1E1E1" />
    <SolidColorBrush x:Key="ClassicHoverBrush" Color="#E5F1FB" />
    <SolidColorBrush x:Key="ClassicPressedBrush" Color="#CCE4F7" />
    <SolidColorBrush x:Key="ClassicAccentBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="ClassicSelectionBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="ClassicDisabledBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="ClassicDisabledTextBrush" Color="#A0A0A0" />
  </Styles.Resources>

  <!-- ============================== Window and text ============================== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource ClassicWindowBrush}" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Verdana, sans-serif" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ============================== Buttons ============================== -->
  <Style Selector="Button, RepeatButton, ToggleButton">
    <Setter Property="Background" Value="{StaticResource ClassicButtonBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicAccentBrush}" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter, RepeatButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicPressedBrush}" />
    <Setter Property="BorderBrush" Value="#005499" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicDisabledBrush}" />
    <Setter Property="BorderBrush" Value="#BFBFBF" />
    <Setter Property="Foreground" Value="{StaticResource ClassicDisabledTextBrush}" />
  </Style>

  <!-- The default action (like a WinForms AcceptButton): same button, blue frame and bold text -->
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicPressedBrush}" />
    <Setter Property="BorderBrush" Value="#005499" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicDisabledBrush}" />
    <Setter Property="BorderBrush" Value="#BFBFBF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource ClassicDisabledTextBrush}" />
  </Style>

  <!-- ============================== Text inputs ============================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicInputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#171717" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource ClassicDisabledBrush}" />
    <Setter Property="BorderBrush" Value="#CCCCCC" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicInputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="23" />
  </Style>
  <Style Selector="ButtonSpinner RepeatButton">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="ButtonSpinner TextBox#PART_TextBox">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="21" />
  </Style>
  <Style Selector="ButtonSpinner TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ============================== Combo boxes ============================== -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicInputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5,2,4,2" />
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="MinHeight" Value="23" />
  </Style>
  <Style Selector="ComboBox /template/ ContentControl#ContentPresenter">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource ClassicHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicAccentBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-within /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{StaticResource ClassicAccentBrush}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource ClassicDisabledBrush}" />
    <Setter Property="BorderBrush" Value="#CCCCCC" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicSelectionBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ============================== Check boxes and radio buttons ============================== -->
  <Style Selector="CheckBox, RadioButton">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="6,0,0,0" />
  </Style>

  <!-- ============================== Lists ============================== -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#828790" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicHoverBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ClassicSelectionBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock, ListBoxItem:selected TextBlock.hint">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ============================== Tabs (WinForms TabControl) ============================== -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="0,2,-1,0" />
    <Setter Property="Background" Value="{StaticResource ClassicWindowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicLightBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="TabItem AccessText, TabItem:selected AccessText">
    <Setter Property="TextDecorations" Value="{x:Null}" />
  </Style>
  <Style Selector="TabItem /template/ Border#PART_SelectedPipe, TabItem:selected /template/ Border#PART_SelectedPipe, TabItem:selected:pointerover /template/ Border#PART_SelectedPipe, TabItem:selected:focus /template/ Border#PART_SelectedPipe">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource ClassicHoverBrush}" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicBorderBrush}" />
    <Setter Property="Margin" Value="0,0,-1,-1" />
    <Setter Property="Padding" Value="10,5,10,6" />
    <Setter Property="ZIndex" Value="1" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="White" />
  </Style>
  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="Background" Value="{StaticResource ClassicPageBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ClassicBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="6,4,6,0" />
  </Style>

  <!-- ============================== Expander ============================== -->
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
</Styles>
