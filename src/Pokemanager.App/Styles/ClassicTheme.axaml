<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Pokemanager.App.Controls">
  <!--
    The application's skin (2026-11-11, user chose "Grafito + color de tu juego"): slate grey, dark by default and light
    in Ajustes, 2 px corners, thin lines, one accent colour taken from the project's game. Every colour is a token of
    App.axaml (DynamicResource, so the variant switches live). On top of FluentTheme (compact density): colours, sizes
    and borders change, not behaviour. The file keeps its old name so nothing that includes it moves.

    Buttons (the system agreed with the user, after Fluent / Material / Nielsen Norman):
      Button.primary  38 px, filled accent: the one action the screen is for (Crear ROM or Jugar, Escribir en la
                      partida, Aplicar…). One per screen.
      Button.tonal    38 px, accent frame on a soft fill: the second important action next to it (Jugar while the ROM
                      is not built).
      Button          30 px, the ordinary (secondary) button.
      Button.text     26 px, no frame, underlined, muted: optional and look-up actions (Ver log, Detalles).
      Button.icon     30×30 square, a glyph with a tooltip (⋯, ↶, ↷).
      Button.danger   26 px, red frame: what cannot be undone, kept apart.
      Button.accent   the old "default action": now the same as primary but at the ordinary height.
  -->
  <Styles.Resources>
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />
  </Styles.Resources>

  <!-- ============================== Window and text ============================== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBaseBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Verdana, sans-serif" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ============================== Buttons ============================== -->
  <Style Selector="Button, RepeatButton, ToggleButton">
    <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter, RepeatButton:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:disabled /template/ ContentPresenter#PART_ContentPresenter, RepeatButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>

  <!-- Primary: the one action of the screen, big and filled -->
  <Style Selector="Button.primary, Button.tonal">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="18,6" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter, Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Tonal: the second important action, framed in the accent without competing -->
  <Style Selector="Button.tonal /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.tonal:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>
  <!-- Text: optional and look-up actions -->
  <Style Selector="Button.text">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.text /template/ ContentPresenter#PART_ContentPresenter, Button.text:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Button.text:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Button.text TextBlock, Button.text AccessText">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <!-- Icon: a glyph everybody knows, always with a tooltip -->
  <Style Selector="Button.icon">
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <!-- Every tab can be dragged out (or right-clicked) to a window of its own: Controls/TabTearOff.cs -->
  <Style Selector="TabControl">
    <Setter Property="c:TabTearOff.Enabled" Value="True" />
  </Style>
  <!-- Fold: the subtle chevron that folds a panel (FoldState). No frame, muted until hovered. -->
  <Style Selector="Button.fold">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.fold /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.fold:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button.fold c|Chevron">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Button.fold:pointerover c|Chevron">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <!-- Danger: what cannot be undone -->
  <Style Selector="Button.danger">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <!-- Menus (the ⋯ of the top bar) -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ============================== Text inputs ============================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox /template/ TextBlock#PART_FloatingWatermark">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
  </Style>
  <Style Selector="NumericUpDown:disabled /template/ ButtonSpinner#PART_Spinner">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
  </Style>
  <!-- The text box sits 1 px over the spinner's border (negative margin): transparent, so the border shows -->
  <Style Selector="NumericUpDown:disabled ButtonSpinner TextBox#PART_TextBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown:disabled ButtonSpinner TextBox#PART_TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>
  <Style Selector="ButtonSpinner TextBox#PART_TextBox">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="ButtonSpinner TextBox#PART_TextBox /template/ Border#PART_BorderElement, ButtonSpinner TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
  </Style>

  <!-- ============================== Date and time pickers ============================== -->
  <Style Selector="CalendarDatePicker">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- The calendar button inside the box, as tall as it, instead of sticking out -->
  <Style Selector="CalendarDatePicker /template/ Button#PART_Button">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
  </Style>
  <!-- Fluent's calendar glyph is drawn for a 24 px tall button and was cut to its "15": hidden, the views draw
       Path.calendar-glyph over the (still clickable) button instead -->
  <Style Selector="CalendarDatePicker /template/ Button#PART_Button > Grid">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Path.calendar-glyph">
    <Setter Property="Data" Value="M1.5,2.5 H12.5 V12.5 H1.5 Z M1.5,5.5 H12.5 M4.5,0.5 V3.5 M9.5,0.5 V3.5 M4,8 H6 M8,8 H10 M4,10.5 H6" />
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,0" />
  </Style>

  <!-- ============================== Scroll bars ============================== -->
  <!-- Always expanded: the thumb reaches the ends and the arrows are visible -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>
  <!-- Single-line text boxes never scroll vertically: with scroll bars always shown, a box 1 px shorter than its text
       (the date picker's) drew a scroll bar over the text. The template binds this attached property, so set it here. -->
  <Style Selector="TextBox[AcceptsReturn=False]">
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>
  <Style Selector="ButtonSpinner TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ============================== Combo boxes ============================== -->
  <Style Selector="ComboBox">
    <!-- Typing inside any dropdown jumps to what you type: the lists here are hundreds of items long. Avalonia's own
         search only looks at the start of the row, and the rows here begin with a number ("#025 Pikachu"). -->
    <Setter Property="c:TypeAhead.IsEnabled" Value="True" />
    <Setter Property="IsTextSearchEnabled" Value="False" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="7,3,6,3" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="ComboBox /template/ ContentControl#ContentPresenter">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-within /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <!-- Rows that name nothing ("???", "(?)": unused ids of the game's item text) are not offered. -->
    <Setter Property="IsVisible" Value="{ReflectionBinding Converter={x:Static c:UnnamedEntry.Visible}}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- ============================== Check boxes and radio buttons ============================== -->
  <Style Selector="CheckBox, RadioButton">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle, CheckBox:checked:pointerover /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Path#CheckGlyph, CheckBox:checked:pointerover /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource AccentInkBrush}" />
  </Style>
  <!-- Fluent draws a checked radio with CheckOuterEllipse (the ring) and CheckGlyph (the dot), not OuterEllipse. -->
  <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse, RadioButton:checked:pointerover /template/ Ellipse#CheckOuterEllipse, RadioButton:checked:pressed /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph, RadioButton:checked:pointerover /template/ Ellipse#CheckGlyph, RadioButton:checked:pressed /template/ Ellipse#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource AccentInkBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- ============================== Lists ============================== -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock, ListBoxItem:selected TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- ============================== Tabs: a line under the selected one ============================== -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TabItem AccessText, TabItem:selected AccessText">
    <Setter Property="TextDecorations" Value="{x:Null}" />
  </Style>
  <Style Selector="TabItem /template/ Border#PART_SelectedPipe, TabItem:selected /template/ Border#PART_SelectedPipe, TabItem:selected:pointerover /template/ Border#PART_SelectedPipe, TabItem:selected:focus /template/ Border#PART_SelectedPipe">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <!-- Selected: bold, its own text colour, and an accent line under it (on the left for side lists) -->
  <Style Selector="TabItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="ZIndex" Value="1" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <!-- Tab strips never wrap into a second row (Fluent uses a WrapPanel): one row on top, one column on the side -->
  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl[TabStripPlacement=Left]">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.wide-side[TabStripPlacement=Left] > TabItem">
    <Setter Property="Width" Value="260" />
  </Style>

  <!-- Side tabs (tab strip on the left): same size selected or not, a bar on the left of the selected one -->
  <Style Selector="TabControl[TabStripPlacement=Left] > TabItem, TabControl[TabStripPlacement=Left] > TabItem:selected">
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="TabControl[TabStripPlacement=Left] > TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>
  <Style Selector="TabControl[TabStripPlacement=Left] > TabItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- The ROM options' subject list: just wide enough for its names, so the page keeps its width at 1024 px (after the side-tab style, so it wins) -->
  <Style Selector="TabControl.narrow-side[TabStripPlacement=Left] > TabItem">
    <Setter Property="MinWidth" Value="120" />
  </Style>
  <Style Selector="TabControl[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="6,8,6,0" />
  </Style>
  <!-- The page under a tab strip: the app's background shows through, a line separates it from the strip -->
  <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="TabControl[TabStripPlacement=Left] /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="8,2,8,0" />
  </Style>

  <!-- Tabs inside a card: flush left, only a rule under the strip, the card's own background -->
  <Style Selector="TabControl.inline /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TabControl.inline /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,8,0,0" />
  </Style>
  <Style Selector="TabControl.inline TabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <!-- ============================== Expander ============================== -->
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="Expander /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
  </Style>
</Styles>
