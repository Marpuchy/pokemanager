<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             xmlns:r="using:Pokemanager.App.Resources"
             xmlns:c="using:Pokemanager.App.Controls"
             x:Class="Pokemanager.App.Views.RandomizerView"
             x:DataType="vm:RandomizerViewModel">
  <TabControl x:Name="Tabs" Padding="0">

    <!-- ======================= Build ======================= -->
    <TabItem Header="{x:Static r:Strings.Rnd_Tab_Build}">
      <ScrollViewer>
        <StackPanel Margin="14,10" Spacing="12">
          <!-- Action bar: what to do, always visible without scrolling -->
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_RandomizerEnabled}" IsChecked="{Binding Enabled}" FontSize="12" FontWeight="SemiBold" Content="{x:Static r:Strings.Rnd_Enable}" />
                <TextBlock Text="{Binding ToolsStatus}" TextWrapping="Wrap" Classes="hint" Classes.error="{Binding !ToolsReady}" />
              </StackPanel>
              <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Margin="4" Content="{x:Static r:Strings.Log_ShowButton}" Command="{Binding ShowLogCommand}"
                        IsEnabled="{Binding HasLog}" ToolTip.Tip="{x:Static r:Strings.Log_ShowTip}" />
                <Button Margin="4" Padding="14,6" Content="{x:Static r:Strings.Editor_Play}" Command="{Binding PlayCommand}" ToolTip.Tip="{x:Static r:Strings.Editor_PlayTip}" />
                <Button Margin="4" Classes="accent" MinWidth="200" Padding="14,6" HorizontalContentAlignment="Center"
                        Content="{x:Static r:Strings.Rnd_BuildButton}" Command="{Binding RandomizeAndBuildCommand}" />
              </WrapPanel>
            </Grid>
          </Border>

          <c:AdaptiveColumnsPanel MinColumnWidth="360" MaxColumns="3" Spacing="12">
          <!-- Card 1: base ROM, options and seed -->
          <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="card-title" Text="{x:Static r:Strings.Rnd_BaseRom}" />
            <TextBlock Text="{Binding BaseRomText}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Rnd_BaseRomHint}" />

            <TextBlock Classes="card-title" Margin="0,10,0,2" Text="{x:Static r:Strings.Rnd_OptionsAndSeed}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding PresetText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Content="{x:Static r:Strings.Rnd_ImportPreset}" Command="{Binding ImportPresetCommand}" />
                <Button Content="{x:Static r:Strings.Rnd_Export}" Command="{Binding ExportPresetCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Rnd_EditOptionsHint}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding SeedText}" PlaceholderText="{x:Static r:Strings.Rnd_SeedWatermark}" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Rnd_NewSeed}" Command="{Binding NewSeedCommand}" />
            </Grid>
            <TextBlock Classes="error" Text="{Binding SeedError}" IsVisible="{Binding SeedError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Rnd_SeedHint}" />
            <!-- The Pokémon, move, trainer and rule files are all in the Data tab, one file per section -->
            <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" Text="{x:Static r:Strings.Data_SeeDataTab}" />
          </StackPanel>
          </Border>

          <!-- Card 2: output ROM -->
          <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="card-title" Text="{x:Static r:Strings.Rnd_OutputRom}" />
            <StackPanel IsVisible="{Binding HasPreviousRom}" Spacing="2">
              <RadioButton ToolTip.Tip="{x:Static r:Strings.Tip_RandomizerReplace}" GroupName="output" IsChecked="{Binding ReplacePrevious}" Content="{Binding PreviousRomText}" />
              <RadioButton ToolTip.Tip="{x:Static r:Strings.Tip_RandomizerCreateNew}" GroupName="output" IsChecked="{Binding CreateNew}" Content="{x:Static r:Strings.Rnd_CreateNew}" />
            </StackPanel>
            <TextBlock Text="{x:Static r:Strings.Rnd_Name}" IsVisible="{Binding IsNameEditable}" />
            <TextBox Text="{Binding OutputName}" IsVisible="{Binding IsNameEditable}" />
            <TextBlock Classes="error" Text="{Binding OutputError}" IsVisible="{Binding OutputError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="hint" Text="{Binding OutputPath}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Foreground="#E07B00" IsVisible="{Binding OutputExists}" Text="{x:Static r:Strings.Rnd_OutputExists}" />
          </StackPanel>
          </Border>

          <!-- Card 3: the save -->
          <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="card-title" Text="{x:Static r:Strings.Rnd_YourSave}" />
            <TextBlock Text="{Binding SaveText}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{Binding SaveTargetText}" TextWrapping="Wrap" />
            <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_RandomizerUpdateSave}" IsChecked="{Binding UpdateSave}" IsEnabled="{Binding HasSave}" Content="{x:Static r:Strings.Rnd_UpdateSave}" />
            <Button Content="{x:Static r:Strings.Rnd_AdaptNow}" Command="{Binding AdaptSaveNowCommand}"
                    IsVisible="{Binding HasPreviousRom}" IsEnabled="{Binding HasSave}"
                    ToolTip.Tip="{x:Static r:Strings.Rnd_AdaptNowTip}" />
            <Border Padding="10" CornerRadius="2" Background="#26E07B00" BorderBrush="#E07B00" BorderThickness="1"
                    IsVisible="{Binding HasSaveWarning}">
              <TextBlock Text="{Binding SaveWarning}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Spacing="4" IsVisible="{Binding SaveChangesSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="card-title" Margin="0,8,0,0" Text="{x:Static r:Strings.Rnd_SaveChanges}" />
              <TextBlock Text="{Binding SaveChangesSummary}" TextWrapping="Wrap" />
              <!-- The details reveal the new abilities and stats: only on request -->
              <Expander Header="{x:Static r:Strings.Rnd_ShowSaveChanges}" HorizontalAlignment="Stretch" IsVisible="{Binding HasSaveChangeDetails}">
                <ItemsControl ItemsSource="{Binding SaveChanges}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaveChangeLine">
                      <TextBlock TextWrapping="Wrap" FontSize="12">
                        <Run Text="{Binding Location}" Foreground="Gray" />
                        <Run Text=" · " />
                        <Run Text="{Binding Pokemon}" FontWeight="SemiBold" />
                        <Run Text=": " />
                        <Run Text="{Binding Description}" />
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </StackPanel>
          </Border>
          </c:AdaptiveColumnsPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ======================= Options ======================= -->
    <TabItem Header="{x:Static r:Strings.Rnd_Tab_Options}">
      <DockPanel DataContext="{Binding Options}" x:DataType="vm:UprOptionsViewModel">
        <TextBlock DockPanel.Dock="Top" Margin="16" Text="{Binding LoadStatus}" TextWrapping="Wrap" IsVisible="{Binding !IsLoaded}" />

        <!-- Groups as side tabs, like the trainer page: one per row, never wrapped into a second strip -->
        <TabControl TabStripPlacement="Left" Classes="wide-side" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" IsVisible="{Binding IsLoaded}">
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UprOptionGroupViewModel">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:UprOptionGroupViewModel">
              <!-- Options of the group, in columns across the width; the Items group also carries ours -->
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <ItemsControl Margin="16,10,16,10" ItemsSource="{Binding Items}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <c:ColumnFlowPanel MinColumnWidth="300" MaxColumns="4" ColumnSpacing="28" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UprOptionViewModel">
                      <StackPanel Margin="0,3" Spacing="2" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Tip}">
                        <CheckBox IsVisible="{Binding IsBool}" IsChecked="{Binding BoolValue}">
                          <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock IsVisible="{Binding !IsBool}" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding ChoiceLabels}" SelectedIndex="{Binding ChoiceIndex}"
                                  HorizontalAlignment="Stretch" MaxDropDownHeight="400" />
                        <NumericUpDown IsVisible="{Binding IsInt}" Value="{Binding IntValue}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                       Increment="1" FormatString="0" ParsingNumberStyle="Integer" Width="150" HorizontalAlignment="Left" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Ours for the same subject, under the randomizer's own: they are written when the ROM is built, so
                     each card says when it acts and nothing about a subject lives on another page. -->
                <WrapPanel Margin="16,0,16,14">
                  <!-- Items and shops -->
                  <Border Classes="card" Width="470" IsVisible="{Binding HasShops}">
                   <StackPanel DataContext="{Binding Shops}" x:DataType="vm:ShopExtrasViewModel">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="card-title" Text="{x:Static r:Strings.Game_ItemsTitle}" />
                      <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Options_OursHint}" />
                      <CheckBox Margin="0,3" IsChecked="{Binding MegaStonesInPool}" IsVisible="{Binding HasMegaStones}"
                                ToolTip.Tip="{x:Static r:Strings.Items_MegaStonesTip}">
                        <TextBlock Text="{Binding MegaStonesText}" TextWrapping="Wrap" />
                      </CheckBox>
                      <CheckBox Margin="0,3" IsChecked="{Binding AllowAllItems}" ToolTip.Tip="{x:Static r:Strings.Items_AllowAllTip}">
                        <TextBlock Text="{x:Static r:Strings.Items_AllowAll}" TextWrapping="Wrap" />
                      </CheckBox>
                      <CheckBox Margin="0,3" IsChecked="{Binding FreeRareCandies}" IsEnabled="{Binding Supported}"
                                ToolTip.Tip="{Binding FreeRareCandiesTip}">
                        <TextBlock Text="{x:Static r:Strings.Shops_FreeCandies}" TextWrapping="Wrap" />
                      </CheckBox>
                      <CheckBox Margin="0,3" IsChecked="{Binding MegaStonesOnSale}" IsEnabled="{Binding Supported}"
                                IsVisible="{Binding HasMegaStones}" ToolTip.Tip="{x:Static r:Strings.Shops_MegaStonesOnSaleTip}">
                        <TextBlock Text="{Binding MegaStonesOnSaleText}" TextWrapping="Wrap" />
                      </CheckBox>
                    </StackPanel>
                   </StackPanel>
                  </Border>

                  <!-- Trainers: the levels of every trainer and what they pay -->
                  <Border Classes="card" Width="470" IsVisible="{Binding IsTrainers}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="card-title" Text="{x:Static r:Strings.Options_TrainerLevels}" />
                      <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Game_LevelsHint}" />
                      <Grid ColumnDefinitions="200,Auto" Margin="0,2">
                        <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_LevelsTrainers}" />
                        <NumericUpDown Grid.Column="1" Width="130" Value="{Binding Game.TrainerLevelPercent}" Minimum="-90" Maximum="400"
                                       Increment="5" FormatString="0.##" />
                      </Grid>
                      <Grid ColumnDefinitions="200,Auto" Margin="0,2">
                        <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_Money}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                          <NumericUpDown Width="110" Value="{Binding Game.MoneyPercent}" Minimum="1" Maximum="1000" Increment="5"
                                         FormatString="0" ParsingNumberStyle="Integer" />
                          <Button Content="{x:Static r:Strings.Game_Apply}" Command="{Binding Game.ApplyMoneyCommand}" />
                          <Button Content="{x:Static r:Strings.Game_Reset}" Command="{Binding Game.ResetCommand}" CommandParameter="money"
                                  ToolTip.Tip="{x:Static r:Strings.Game_ResetTip}" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding Game.HasPresetTrainerLevel}">
                        <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Text="{Binding Game.PresetTrainerLevelText}" />
                        <Button Content="{x:Static r:Strings.Options_ClearPreset}" Command="{Binding Game.ClearPresetTrainerLevelCommand}" />
                      </StackPanel>
                      <TextBlock Text="{Binding Game.Result}" FontWeight="SemiBold"
                                 IsVisible="{Binding Game.Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>

                  <!-- Wild Pokemon -->
                  <Border Classes="card" Width="470" IsVisible="{Binding IsWild}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="card-title" Text="{x:Static r:Strings.Options_WildLevels}" />
                      <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Game_LevelsHint}" />
                      <Grid ColumnDefinitions="200,Auto" Margin="0,2">
                        <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_LevelsWild}" />
                        <NumericUpDown Grid.Column="1" Width="130" Value="{Binding Game.WildLevelPercent}" Minimum="-90" Maximum="400"
                                       Increment="5" FormatString="0.##" ToolTip.Tip="{Binding Game.WildStaticTip}" />
                      </Grid>                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding Game.HasPresetWildLevel}">
                        <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Text="{Binding Game.PresetWildLevelText}" />
                        <Button Content="{x:Static r:Strings.Options_ClearPreset}" Command="{Binding Game.ClearPresetWildLevelCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- Fixed Pokemon, gifts and totems -->
                  <Border Classes="card" Width="470" IsVisible="{Binding IsStatic}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="card-title" Text="{x:Static r:Strings.Options_StaticLevels}" />
                      <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Game_LevelsHint}" />
                      <Grid ColumnDefinitions="200,Auto" Margin="0,2">
                        <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_LevelsStatic}" />
                        <NumericUpDown Grid.Column="1" Width="130" Value="{Binding Game.StaticLevelPercent}" Minimum="-90" Maximum="400"
                                       Increment="5" FormatString="0.##" ToolTip.Tip="{Binding Game.WildStaticTip}" />
                      </Grid>                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding Game.HasPresetStaticLevel}">
                        <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Text="{Binding Game.PresetStaticLevelText}" />
                        <Button Content="{x:Static r:Strings.Options_ClearPreset}" Command="{Binding Game.ClearPresetStaticLevelCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- The personal table of every Pokemon of the game, in one go -->
                  <Border Classes="card" Width="470" IsVisible="{Binding IsPokemon}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="card-title" Text="{x:Static r:Strings.Game_SweepsTitle}" />
                      <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Game_SweepsHint}" />
                      <Grid ColumnDefinitions="180,Auto" Margin="0,2">
                        <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_Experience}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                          <NumericUpDown Width="110" Value="{Binding Game.ExperiencePercent}" Minimum="1" Maximum="1000" Increment="5" FormatString="0" ParsingNumberStyle="Integer" />
                          <Button Content="{x:Static r:Strings.Game_Apply}" Command="{Binding Game.ApplyExperienceCommand}" />
                          <Button Content="{x:Static r:Strings.Game_Reset}" Command="{Binding Game.ResetCommand}" CommandParameter="baseExp" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="180,Auto" Margin="0,2">
                        <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_CatchRate}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                          <NumericUpDown Width="110" Value="{Binding Game.CatchRatePercent}" Minimum="1" Maximum="1000" Increment="5" FormatString="0" ParsingNumberStyle="Integer" />
                          <Button Content="{x:Static r:Strings.Game_Apply}" Command="{Binding Game.ApplyCatchRateCommand}" />
                          <Button Content="{x:Static r:Strings.Game_Reset}" Command="{Binding Game.ResetCommand}" CommandParameter="catchRate" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="180,Auto" Margin="0,2">
                        <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_Hatch}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                          <NumericUpDown Width="110" Value="{Binding Game.HatchPercent}" Minimum="1" Maximum="1000" Increment="5" FormatString="0" ParsingNumberStyle="Integer" />
                          <Button Content="{x:Static r:Strings.Game_Apply}" Command="{Binding Game.ApplyHatchCommand}" />
                          <Button Content="{x:Static r:Strings.Game_Reset}" Command="{Binding Game.ResetCommand}" CommandParameter="hatchCycles" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="180,Auto" Margin="0,2">
                        <TextBlock Classes="row-label" VerticalAlignment="Center" Text="{x:Static r:Strings.Game_Friendship}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                          <NumericUpDown Width="110" Value="{Binding Game.FriendshipValue}" Minimum="0" Maximum="255" Increment="5" FormatString="0" ParsingNumberStyle="Integer" />
                          <Button Content="{x:Static r:Strings.Game_Apply}" Command="{Binding Game.ApplyFriendshipCommand}" />
                          <Button Content="{x:Static r:Strings.Game_Reset}" Command="{Binding Game.ResetCommand}" CommandParameter="baseFriendship" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding Game.Result}" FontWeight="SemiBold"
                                 IsVisible="{Binding Game.Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>

                  <!-- The whole game: shiny -->
                  <Border Classes="card" Width="470" IsVisible="{Binding IsMisc}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="card-title" Text="{x:Static r:Strings.Game_ShinyTitle}" />
                      <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static r:Strings.Options_OursHint}" />
                      <CheckBox IsChecked="{Binding Game.AlwaysShiny}" IsEnabled="{Binding Game.ShinySupported}" ToolTip.Tip="{Binding Game.ShinyTip}"
                                Content="{x:Static r:Strings.Game_Shiny}" />
                    </StackPanel>
                  </Border>

                  <!-- The whole game: the level cap by milestones, with its plan -->
                  <Border Classes="card" Width="470" IsVisible="{Binding IsMisc}">
                    <Border.Styles>
                      <Style Selector="Border.current">
                        <Setter Property="Background" Value="#E8F1FB" />
                      </Style>
                      <Style Selector="Border.current TextBlock">
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Style>
                    </Border.Styles>
                    <StackPanel Spacing="4" DataContext="{Binding Game.LevelCap}" x:DataType="vm:LevelCapViewModel">
                      <TextBlock Classes="card-title" Text="{x:Static r:Strings.LevelCap_Title}" />
                      <CheckBox IsChecked="{Binding Enabled}" IsEnabled="{Binding Supported}" ToolTip.Tip="{Binding EnabledTip}"
                                Content="{x:Static r:Strings.LevelCap_Enable}" />
                      <CheckBox IsChecked="{Binding TrimOverCap}" IsVisible="{Binding Enabled}" ToolTip.Tip="{x:Static r:Strings.Tip_LevelCapTrim}"
                                Content="{x:Static r:Strings.LevelCap_TrimEnable}" />
                      <TextBlock Text="{Binding CurrentText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding Enabled}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LevelCapStepViewModel">
                            <Border Classes="info-row" Classes.current="{Binding IsCurrent}" Padding="4,1">
                              <Grid ColumnDefinitions="24,*,90,Auto">
                                <Image Source="{Binding Icon}" Width="20" Height="20" IsVisible="{Binding HasIcon}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" />
                                <NumericUpDown Grid.Column="2" Value="{Binding Level}" Minimum="1" Maximum="100" Increment="1" FormatString="0"
                                               ParsingNumberStyle="Integer" ToolTip.Tip="{Binding Tip}" />
                                <TextBlock Grid.Column="3" Margin="8,0,0,0" MinWidth="60" VerticalAlignment="Center" Text="{Binding State}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </WrapPanel>
                </StackPanel>
              </ScrollViewer>
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>
      </DockPanel>
    </TabItem>
  </TabControl>
</UserControl>
