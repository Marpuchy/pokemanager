<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             xmlns:r="using:Pokemanager.App.Resources"
             xmlns:c="using:Pokemanager.App.Controls"
             x:Class="Pokemanager.App.Views.RandomizerView"
             x:DataType="vm:RandomizerViewModel">
  <!-- Proyecto → Generar: base ROM, seed, output and the save (the options live in each subject's tab) -->
      <ScrollViewer>
        <StackPanel Margin="14,10" Spacing="12">
          <!-- Action bar: what to do, always visible without scrolling -->
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_RandomizerEnabled}" IsChecked="{Binding Enabled}" FontSize="12" FontWeight="SemiBold" Content="{x:Static r:Strings.Rnd_Enable}" />
                <TextBlock Text="{Binding ToolsStatus}" TextWrapping="Wrap" Classes="hint" Classes.error="{Binding !ToolsReady}" />
              </StackPanel>
              <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Margin="4" Content="{x:Static r:Strings.Log_ShowButton}" Command="{Binding ShowLogCommand}"
                        IsEnabled="{Binding HasLog}" ToolTip.Tip="{x:Static r:Strings.Log_ShowTip}" />
              </WrapPanel>
            </Grid>
          </Border>

          <c:AdaptiveColumnsPanel MinColumnWidth="360" MaxColumns="3" Spacing="12">
          <!-- Card 1: base ROM, options and seed -->
          <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="card-title" Text="{x:Static r:Strings.Rnd_BaseRom}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding BaseRomText}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Set_Change}" Command="{Binding ChangeBaseRomCommand}"
                      ToolTip.Tip="{x:Static r:Strings.Set_ChangeBaseRomTip}" />
            </Grid>
            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding BaseRomProblem}"
                       IsVisible="{Binding BaseRomProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Rnd_BaseRomHint}" />

            <TextBlock Classes="card-title" Margin="0,10,0,2" Text="{x:Static r:Strings.Rnd_OptionsAndSeed}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding PresetText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Rnd_EditOptionsHint}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding SeedText}" PlaceholderText="{x:Static r:Strings.Rnd_SeedWatermark}" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Rnd_NewSeed}" Command="{Binding NewSeedCommand}" />
            </Grid>
            <TextBlock Classes="error" Text="{Binding SeedError}" IsVisible="{Binding SeedError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Rnd_SeedHint}" />
            <!-- The Pokémon, move, trainer and rule files are all in the Data tab, one file per section -->
            <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" Text="{x:Static r:Strings.Data_SeeDataTab}" />
          </StackPanel>
          </Border>

          <!-- Card 2: output ROM -->
          <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="card-title" Text="{x:Static r:Strings.Rnd_OutputRom}" />
            <StackPanel IsVisible="{Binding HasPreviousRom}" Spacing="2">
              <RadioButton ToolTip.Tip="{x:Static r:Strings.Tip_RandomizerReplace}" GroupName="output" IsChecked="{Binding ReplacePrevious}" Content="{Binding PreviousRomText}" />
              <RadioButton ToolTip.Tip="{x:Static r:Strings.Tip_RandomizerCreateNew}" GroupName="output" IsChecked="{Binding CreateNew}" Content="{x:Static r:Strings.Rnd_CreateNew}" />
            </StackPanel>
            <TextBlock Text="{x:Static r:Strings.Rnd_Name}" IsVisible="{Binding IsNameEditable}" />
            <TextBox Text="{Binding OutputName}" IsVisible="{Binding IsNameEditable}" />
            <TextBlock Classes="error" Text="{Binding OutputError}" IsVisible="{Binding OutputError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="hint" Text="{Binding OutputPath}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Foreground="{DynamicResource ModifiedBrush}" IsVisible="{Binding OutputExists}" Text="{x:Static r:Strings.Rnd_OutputExists}" />
          </StackPanel>
          </Border>

          <!-- Card 3: the save -->
          <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="card-title" Text="{x:Static r:Strings.Rnd_YourSave}" />
            <!-- The save's full path in the tooltip, as in Partida (2026-11-09, user) -->
            <TextBlock Text="{Binding SaveText}" TextWrapping="Wrap" ToolTip.Tip="{Binding SaveTargetText}" />
            <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_RandomizerUpdateSave}" IsChecked="{Binding UpdateSave}" IsEnabled="{Binding HasSave}" Content="{x:Static r:Strings.Rnd_UpdateSave}" />
            <Button Content="{x:Static r:Strings.Rnd_AdaptNow}" Command="{Binding AdaptSaveNowCommand}"
                    IsVisible="{Binding HasPreviousRom}" IsEnabled="{Binding HasSave}"
                    ToolTip.Tip="{x:Static r:Strings.Rnd_AdaptNowTip}" />
            <Border Padding="10" CornerRadius="2" Background="{DynamicResource WarningBrush}" BorderBrush="{DynamicResource ModifiedBrush}" BorderThickness="1"
                    IsVisible="{Binding HasSaveWarning}">
              <TextBlock Text="{Binding SaveWarning}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Spacing="4" IsVisible="{Binding SaveChangesSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="card-title" Margin="0,8,0,0" Text="{x:Static r:Strings.Rnd_SaveChanges}" />
              <TextBlock Text="{Binding SaveChangesSummary}" TextWrapping="Wrap" />
              <!-- The details reveal the new abilities and stats: only on request -->
              <Expander Header="{x:Static r:Strings.Rnd_ShowSaveChanges}" HorizontalAlignment="Stretch" IsVisible="{Binding HasSaveChangeDetails}">
                <ItemsControl ItemsSource="{Binding SaveChanges}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaveChangeLine">
                      <TextBlock TextWrapping="Wrap" FontSize="12">
                        <Run Text="{Binding Location}" Foreground="Gray" />
                        <Run Text=" · " />
                        <Run Text="{Binding Pokemon}" FontWeight="SemiBold" />
                        <Run Text=": " />
                        <Run Text="{Binding Description}" />
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </StackPanel>
          </Border>
          </c:AdaptiveColumnsPanel>
        </StackPanel>
      </ScrollViewer>
</UserControl>
