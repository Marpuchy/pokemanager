<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             xmlns:r="using:Pokemanager.App.Resources"
             x:Class="Pokemanager.App.Views.RandomizerView"
             x:DataType="vm:RandomizerViewModel">
  <TabControl x:Name="Tabs" Padding="0">

    <!-- ======================= Build ======================= -->
    <TabItem Header="{x:Static r:Strings.Rnd_Tab_Build}">
      <Grid ColumnDefinitions="500,*">
        <ScrollViewer Margin="0,0,8,0">
          <StackPanel Margin="16,8" Spacing="6">
            <CheckBox IsChecked="{Binding Enabled}" FontSize="15" FontWeight="SemiBold" Content="{x:Static r:Strings.Rnd_Enable}" />
            <TextBlock Text="{Binding ToolsStatus}" TextWrapping="Wrap" Classes="hint" Classes.error="{Binding !ToolsReady}" />

            <TextBlock Classes="section" Text="{x:Static r:Strings.Rnd_BaseRom}" />
            <TextBlock Text="{Binding BaseRomText}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Rnd_BaseRomHint}" />

            <TextBlock Classes="section" Text="{x:Static r:Strings.Rnd_OptionsAndSeed}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding PresetText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Content="{x:Static r:Strings.Rnd_ImportPreset}" Command="{Binding ImportPresetCommand}" />
                <Button Content="{x:Static r:Strings.Rnd_Export}" Command="{Binding ExportPresetCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Rnd_EditOptionsHint}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding SeedText}" PlaceholderText="{x:Static r:Strings.Rnd_SeedWatermark}" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Rnd_NewSeed}" Command="{Binding NewSeedCommand}" />
            </Grid>
            <TextBlock Classes="error" Text="{Binding SeedError}" IsVisible="{Binding SeedError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Rnd_SeedHint}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBlock Text="{x:Static r:Strings.Data_RandomizerRow}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Content="{x:Static r:Strings.Data_ImportShort}" Command="{Binding ImportPokemonDataCommand}" />
                <Button Content="{x:Static r:Strings.Rnd_Export}" Command="{Binding ExportPokemonDataCommand}" />
              </StackPanel>
            </Grid>

            <TextBlock Classes="section" Text="{x:Static r:Strings.Rnd_OutputRom}" />
            <StackPanel IsVisible="{Binding HasPreviousRom}" Spacing="2">
              <RadioButton GroupName="output" IsChecked="{Binding ReplacePrevious}" Content="{Binding PreviousRomText}" />
              <RadioButton GroupName="output" IsChecked="{Binding CreateNew}" Content="{x:Static r:Strings.Rnd_CreateNew}" />
            </StackPanel>
            <TextBlock Text="{x:Static r:Strings.Rnd_Name}" IsVisible="{Binding IsNameEditable}" />
            <TextBox Text="{Binding OutputName}" IsVisible="{Binding IsNameEditable}" />
            <TextBlock Classes="error" Text="{Binding OutputError}" IsVisible="{Binding OutputError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="hint" Text="{Binding OutputPath}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Foreground="#E07B00" IsVisible="{Binding OutputExists}" Text="{x:Static r:Strings.Rnd_OutputExists}" />

            <TextBlock Classes="section" Text="{x:Static r:Strings.Rnd_YourSave}" />
            <TextBlock Text="{Binding SaveText}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{Binding SaveTargetText}" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding UpdateSave}" IsEnabled="{Binding HasSave}" Content="{x:Static r:Strings.Rnd_UpdateSave}" />
            <Button Content="{x:Static r:Strings.Rnd_AdaptNow}" Command="{Binding AdaptSaveNowCommand}"
                    IsVisible="{Binding HasPreviousRom}" IsEnabled="{Binding HasSave}"
                    ToolTip.Tip="{x:Static r:Strings.Rnd_AdaptNowTip}" />
            <Border Padding="10" CornerRadius="4" Background="#26E07B00" BorderBrush="#E07B00" BorderThickness="1"
                    IsVisible="{Binding HasSaveWarning}">
              <TextBlock Text="{Binding SaveWarning}" TextWrapping="Wrap" />
            </Border>

            <Button Classes="accent" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="{x:Static r:Strings.Rnd_BuildButton}" Command="{Binding RandomizeAndBuildCommand}" />

            <TextBlock Classes="section" Text="{x:Static r:Strings.Rnd_SaveChanges}" IsVisible="{Binding SaveChangesSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding SaveChangesSummary}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding SaveChanges}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SaveChangeLine">
                  <TextBlock TextWrapping="Wrap" FontSize="12">
                    <Run Text="{Binding Location}" Foreground="Gray" />
                    <Run Text=" · " />
                    <Run Text="{Binding Pokemon}" FontWeight="SemiBold" />
                    <Run Text=": " />
                    <Run Text="{Binding Description}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- UPR log -->
        <DockPanel Grid.Column="1" Margin="8">
          <TextBlock DockPanel.Dock="Top" Classes="section" Margin="0,0,0,6" Text="{x:Static r:Strings.Log_Title}" />
          <Grid DockPanel.Dock="Top" ColumnDefinitions="300,*">
            <ComboBox ItemsSource="{Binding LogSections}" SelectedItem="{Binding SelectedLogSection}"
                      HorizontalAlignment="Stretch" MaxDropDownHeight="420">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Grid.Column="1" Margin="6,0,0,0" Text="{Binding LogFilter}" PlaceholderText="{x:Static r:Strings.Log_SearchWatermark}" />
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,4" Text="{Binding LogSummary}" />
          <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <ListBox ItemsSource="{Binding VisibleLog}" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="6,0" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListBox.Styles>
            </ListBox>
          </Border>
        </DockPanel>
      </Grid>
    </TabItem>

    <!-- ======================= Options ======================= -->
    <TabItem Header="{x:Static r:Strings.Rnd_Tab_Options}">
      <Grid ColumnDefinitions="280,*" DataContext="{Binding Options}" x:DataType="vm:UprOptionsViewModel">
        <TextBlock Grid.ColumnSpan="2" Margin="16" Text="{Binding LoadStatus}" TextWrapping="Wrap" IsVisible="{Binding !IsLoaded}" />

        <ListBox Margin="8" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" IsVisible="{Binding IsLoaded}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:UprOptionGroupViewModel">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Column="1" IsVisible="{Binding IsLoaded}">
          <StackPanel Margin="12,8,16,8">
            <TextBlock Classes="section" Text="{Binding SelectedGroup.Name}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding SelectedGroup.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UprOptionViewModel">
                  <Grid ColumnDefinitions="360,*" Margin="0,3" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Hint}">
                    <CheckBox Grid.ColumnSpan="2" IsVisible="{Binding IsBool}" IsChecked="{Binding BoolValue}">
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock IsVisible="{Binding !IsBool}" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" IsVisible="{Binding IsChoice}" ItemsSource="{Binding ChoiceLabels}"
                              SelectedIndex="{Binding ChoiceIndex}" MinWidth="280" />
                    <NumericUpDown Grid.Column="1" IsVisible="{Binding IsInt}" Value="{Binding IntValue}" Minimum="{Binding Min}"
                                   Maximum="{Binding Max}" Increment="1" FormatString="0" ParsingNumberStyle="Integer" Width="150"
                                   HorizontalAlignment="Left" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
