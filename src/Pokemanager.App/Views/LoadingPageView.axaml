<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             x:Class="Pokemanager.App.Views.LoadingPageView"
             x:DataType="vm:LoadingPageViewModel">
  <!-- The editor's shape: its bar, the tabs, the side list and a page of cards -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Classes="skeleton" Width="40" Height="40" />
        <StackPanel Grid.Column="1" Margin="12,0" Spacing="6" VerticalAlignment="Center">
          <TextBlock FontWeight="SemiBold" Text="{Binding Text}" />
          <Border Classes="skeleton" Width="360" Height="10" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Border Classes="skeleton" Width="80" Height="30" />
          <Border Classes="skeleton" Width="90" Height="30" />
          <Border Classes="skeleton" Width="120" Height="30" />
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="18" Margin="16,12">
      <Border Classes="skeleton" Width="70" Height="14" />
      <Border Classes="skeleton" Width="120" Height="14" />
      <Border Classes="skeleton" Width="70" Height="14" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Width="110" Margin="16,8" Spacing="16">
      <Border Classes="skeleton" Height="14" />
      <Border Classes="skeleton" Height="14" />
      <Border Classes="skeleton" Height="14" />
      <Border Classes="skeleton" Height="14" />
      <Border Classes="skeleton" Height="14" />
    </StackPanel>
    <Grid Margin="8,8,16,16" ColumnDefinitions="*,12,*,12,*" RowDefinitions="Auto,12,Auto">
      <Border Classes="skeleton" Height="260" />
      <Border Grid.Column="2" Classes="skeleton" Height="260" />
      <Border Grid.Column="4" Classes="skeleton" Height="260" />
      <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="skeleton" Height="200" />
      <Border Grid.Row="2" Grid.Column="4" Classes="skeleton" Height="200" />
    </Grid>
  </DockPanel>
</UserControl>
