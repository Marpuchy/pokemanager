<Window xmlns="https://github.com/avaloniaui"
        Icon="avares://Pokemanager.App/Assets/pokemanager.ico"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pokemanager.App.ViewModels"
        xmlns:r="using:Pokemanager.App.Resources"
        x:Class="Pokemanager.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{x:Static r:Strings.Set_Title}"
        Width="780" Height="820" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="6">
      <TextBlock Text="{x:Static r:Strings.Set_Title}" FontSize="16" FontWeight="SemiBold" />

      <!-- Profile: how the user appears in multiplayer rooms -->
      <TextBlock Classes="section" Text="{x:Static r:Strings.Profile_Title}" />
      <TextBlock Classes="hint" Text="{x:Static r:Strings.Profile_Hint}" />
      <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
        <ContentControl Content="{Binding ProfileAvatar}" Width="88" Height="88" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6">
          <TextBlock Text="{x:Static r:Strings.Profile_Name}" />
          <TextBox Text="{Binding ProfileName}" PlaceholderText="{x:Static r:Strings.Profile_NamePlaceholder}" MaxLength="24" MaxWidth="320" HorizontalAlignment="Left" MinWidth="240" />
          <TextBlock Text="{x:Static r:Strings.Profile_Color}" />
          <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.ProfileColors}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ColorOption">
                <Button Width="26" Height="26" Margin="0,0,4,0" Padding="0" CornerRadius="13" Background="{Binding Brush}" BorderBrush="#40000000" BorderThickness="1"
                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ChooseColorCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="hint" Text="{Binding ProfileSpriteText}" />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
        <TextBox Text="{Binding SpriteQuery}" PlaceholderText="{x:Static r:Strings.Profile_SearchPlaceholder}" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Profile_ChooseImage}" Command="{Binding ChooseImageCommand}" />
        <Button Grid.Column="2" Margin="6,0,0,0" Content="{x:Static r:Strings.Profile_RemoveImage}" Command="{Binding RemoveImageCommand}" IsVisible="{Binding HasCustomImage}" />
      </Grid>
      <TextBlock Classes="hint" Text="{Binding SpriteStatus}" />
      <ItemsControl ItemsSource="{Binding SpriteResults}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SpriteOption">
            <Button Width="72" Height="72" Margin="0,0,4,4" Padding="2" Command="{Binding ChooseCommand}" ToolTip.Tip="{Binding Name}">
              <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="hint" FontSize="11" Text="{x:Static r:Strings.Profile_Credit}" />

      <TextBlock Classes="section" Text="{x:Static r:Strings.Set_Language}" />
      <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.UiLanguages}" SelectedItem="{Binding SelectedLanguage}" MinWidth="200">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:UiLanguageOption">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Classes="hint" Foreground="#E07B00" Text="{x:Static r:Strings.Set_LanguageHint}" IsVisible="{Binding LanguageChanged}" />

      <TextBlock Classes="section" Text="{x:Static r:Strings.Set_Emulator}" />
      <TextBlock Classes="hint" Text="{x:Static r:Strings.Set_EmulatorHint}" />
      <Grid ColumnDefinitions="*,Auto">
        <ComboBox ItemsSource="{Binding Emulators}" SelectedItem="{Binding SelectedEmulator}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EmulatorOption">
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Set_OtherFolder}" Command="{Binding BrowseEmulatorCommand}" />
      </Grid>
      <TextBlock Text="{Binding EffectiveText}" TextWrapping="Wrap" />
      <TextBlock Classes="hint" Text="{Binding SaveText}" />
      <TextBlock Margin="0,8,0,0" Text="{x:Static r:Strings.Set_ProgramLabel}" />
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding ExecutableText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Set_ProgramBrowse}" Command="{Binding BrowseExecutableCommand}" />
        <Button Grid.Column="2" Margin="6,0,0,0" Content="{x:Static r:Strings.Set_ProgramDetect}" Command="{Binding DetectExecutableCommand}"
                IsVisible="{Binding HasChosenExecutable}" />
      </Grid>

      <StackPanel IsVisible="{Binding HasProject}" Spacing="6">
        <TextBlock Classes="section" Text="{x:Static r:Strings.Set_CurrentProject}" />
        <TextBlock Text="{x:Static r:Strings.Set_BaseRom}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding BaseRomText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Set_Change}" Command="{Binding BrowseBaseRomCommand}" />
        </Grid>
      </StackPanel>

      <!-- Version history of the open project: it used to be a tab of the editor -->
      <StackPanel IsVisible="{Binding HasHistory}">
        <TextBlock Classes="section" Text="{x:Static r:Strings.History_Title}" />
        <TextBlock Classes="hint" Text="{x:Static r:Strings.Set_HistoryHint}" TextWrapping="Wrap" />
        <Button Margin="0,6,0,0" HorizontalAlignment="Left" Content="{x:Static r:Strings.Set_OpenHistory}" Command="{Binding OpenHistoryCommand}" />
      </StackPanel>

      <TextBlock Classes="section" Text="{x:Static r:Strings.Set_Tools}" />
      <TextBlock Text="{Binding UprText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding PkhexText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding JavaText}" TextWrapping="Wrap" />

      <TextBlock Classes="section" Text="{x:Static r:Strings.Set_AppData}" />
      <TextBlock Classes="hint" Text="{Binding CacheText}" />
      <TextBlock Classes="hint" Text="{Binding BackupText}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="{x:Static r:Strings.Set_ClearCache}" Command="{Binding ClearCacheCommand}" />
        <Button Content="{x:Static r:Strings.Set_OpenBackups}" Command="{Binding OpenBackupsCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
