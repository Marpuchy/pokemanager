<Window xmlns="https://github.com/avaloniaui"
        Icon="avares://Pokemanager.App/Assets/pokemanager.ico"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pokemanager.App.ViewModels"
        x:Class="Pokemanager.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <!-- The background (Services/AppTheme): the slate gradient, the game's glow, then a faint pattern; the pages over it -->
  <Panel>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="{DynamicResource AppBase2Color}" Offset="0" />
          <GradientStop Color="{DynamicResource AppBaseColor}" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border Background="{DynamicResource AppGlowBrush}" />
    <Border Background="{DynamicResource AppPatternBrush}" />
    <ContentControl Content="{Binding CurrentPage}" />
  </Panel>
</Window>
