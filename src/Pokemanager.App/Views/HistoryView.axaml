<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             xmlns:r="using:Pokemanager.App.Resources"
             x:Class="Pokemanager.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <DockPanel Margin="16,8,16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="section" Text="{x:Static r:Strings.History_Title}" />
      <TextBlock Classes="hint" Text="{x:Static r:Strings.History_Hint}" MaxWidth="900" HorizontalAlignment="Left" />
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
        <Button Classes="accent" Content="{x:Static r:Strings.History_RestoreButton}" Command="{Binding RestoreCommand}" />
        <Button Content="{x:Static r:Strings.History_SaveButton}" Command="{Binding SaveVersionCommand}" />
        <Button Content="{x:Static r:Strings.History_DeleteButton}" Command="{Binding DeleteCommand}" />
      </StackPanel>
      <TextBlock Classes="hint" Text="{Binding FolderText}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <Grid>
      <TextBlock Classes="hint" Margin="0,16" Text="{x:Static r:Strings.History_Empty}" IsVisible="{Binding IsEmpty}" />
      <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}" IsVisible="{Binding !IsEmpty}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:VersionItemViewModel">
            <Grid ColumnDefinitions="190,*" Margin="0,4">
              <StackPanel>
                <TextBlock Text="{Binding When}" FontWeight="SemiBold" />
                <TextBlock Classes="hint" Text="{Binding KindText}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Note}" FontStyle="Italic" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock Classes="hint" Text="{Binding Difference}" Classes.current="{Binding IsCurrent}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</UserControl>
