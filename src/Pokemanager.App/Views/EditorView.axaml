<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             xmlns:r="using:Pokemanager.App.Resources"
             x:Class="Pokemanager.App.Views.EditorView"
             x:DataType="vm:EditorViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding BuildRomCommand}" />
  </UserControl.KeyBindings>

  <UserControl.DataTemplates>
    <!-- Numeric field: label (orange when it differs from the base) + NumericUpDown -->
    <DataTemplate DataType="vm:IntFieldViewModel">
      <Grid ColumnDefinitions="190,150" Margin="0,2" ToolTip.Tip="{Binding OriginalTip}">
        <TextBlock Classes="field-label" Classes.modified="{Binding IsModified}" Text="{Binding Label}" />
        <NumericUpDown Grid.Column="1" Value="{Binding Value}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                       Increment="1" FormatString="0" ParsingNumberStyle="Integer" />
      </Grid>
    </DataTemplate>
    <!-- List field: label + ComboBox with the game's names -->
    <DataTemplate DataType="vm:ChoiceFieldViewModel">
      <Grid ColumnDefinitions="190,240" Margin="0,2" ToolTip.Tip="{Binding OriginalTip}">
        <TextBlock Classes="field-label" Classes.modified="{Binding IsModified}" Text="{Binding Label}" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}"
                  HorizontalAlignment="Stretch" MaxDropDownHeight="360" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:ListEntryViewModel">
      <Grid ColumnDefinitions="Auto,48,*,Auto">
        <Image Classes="sprite" RenderOptions.BitmapInterpolationMode="None" Source="{Binding Icon}" Width="40" Height="30" Margin="0,0,6,0" IsVisible="{Binding HasIcon}" />
        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Number}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="3" Classes="dot" Text="●" IsVisible="{Binding IsModified}" ToolTip.Tip="{x:Static r:Strings.Detail_Modified}" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <!-- Top bar -->
    <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding GameText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="hint">
            <Run Text="{Binding BaseText}" />
            <Run Text=" · " />
            <Run Text="{Binding EditCountText}" />
            <Run Text=" · " />
            <Run Text="{Binding DirtyText}" />
            <Run Text=" · " />
            <Run Text="{Binding EmulatorText}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" />
          <Button Content="{x:Static r:Strings.Editor_Save}" Command="{Binding SaveCommand}" ToolTip.Tip="Ctrl+S" />
          <Button Content="{x:Static r:Strings.Editor_Play}" Command="{Binding PlayCommand}" ToolTip.Tip="{x:Static r:Strings.Editor_PlayTip}" />
          <Button Classes="accent" Content="{x:Static r:Strings.Editor_BuildRom}" Command="{Binding BuildRomCommand}"
                  ToolTip.Tip="{x:Static r:Strings.Editor_BuildRomTip}" />
          <Button Content="{x:Static r:Strings.Editor_Settings}" Command="{Binding OpenSettingsCommand}" />
          <Button Content="{x:Static r:Strings.Editor_Open}" Command="{Binding OpenOtherProjectCommand}" />
          <Button Content="{x:Static r:Strings.Editor_Projects}" Command="{Binding NewProjectCommand}" ToolTip.Tip="{x:Static r:Strings.Editor_ProjectsTip}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes.error="{Binding StatusIsError}" />
    </Border>

    <TabControl x:Name="MainTabs" Padding="0">
      <!-- ================= Randomizer ================= -->
      <TabItem Header="{x:Static r:Strings.Tab_Randomizer}">
        <ContentControl Content="{Binding Randomizer}" />
      </TabItem>

      <!-- ================= Save file ================= -->
      <TabItem x:Name="SaveTab" Header="{x:Static r:Strings.Tab_Save}">
        <ContentControl Content="{Binding SaveEditor}" />
      </TabItem>

      <!-- ================= History ================= -->
      <TabItem x:Name="HistoryTab" Header="{x:Static r:Strings.Tab_History}">
        <ContentControl Content="{Binding History}" />
      </TabItem>

      <!-- ================= Advanced: Pokémon ================= -->
      <TabItem Header="{x:Static r:Strings.Tab_AdvancedPokemon}">
        <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="{x:Static r:Strings.Data_ImportButton}" Command="{Binding ImportPokemonDataCommand}" />
            <Button Content="{x:Static r:Strings.Data_ExportButton}" Command="{Binding ExportPokemonDataCommand}" />
            <TextBlock Classes="hint" VerticalAlignment="Center" Text="{x:Static r:Strings.Data_Hint}" />
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="300,*">
          <DockPanel Margin="8">
            <TextBox DockPanel.Dock="Top" Text="{Binding SpeciesFilter}" PlaceholderText="{x:Static r:Strings.Search_Watermark}" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Species}" SelectedItem="{Binding SelectedSpecies}" />
          </DockPanel>

          <ContentControl Grid.Column="1" Content="{Binding SpeciesDetail}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:SpeciesDetailViewModel">
                <DockPanel Margin="8,8,12,8">
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                    <Image Classes="sprite" RenderOptions.BitmapInterpolationMode="None" Source="{Binding Icon}" Width="80" Height="60" Margin="0,0,10,0"
                           IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="{x:Static r:Strings.Detail_Revert}" Command="{Binding RevertCommand}" IsEnabled="{Binding IsModified}" VerticalAlignment="Center" />
                  </Grid>
                  <TabControl>
                    <TabItem Header="{x:Static r:Strings.Detail_Data}">
                      <ScrollViewer>
                        <WrapPanel Orientation="Horizontal">
                          <StackPanel Margin="0,0,32,0" Width="360">
                            <TextBlock Classes="section" Text="{x:Static r:Strings.Section_BaseStats}" />
                            <ItemsControl ItemsSource="{Binding Stats}" />
                            <TextBlock Margin="0,4,0,0">
                              <Run Text="{x:Static r:Strings.Section_Total}" />
                              <Run Text=" " />
                              <Run Text="{Binding BaseStatTotal}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Classes="section" Text="{x:Static r:Strings.Section_EvYield}" />
                            <ItemsControl ItemsSource="{Binding EvYield}" />
                            <TextBlock Classes="section" Text="{x:Static r:Strings.Section_Other}" />
                            <ItemsControl ItemsSource="{Binding Other}" />
                          </StackPanel>
                          <StackPanel Width="450">
                            <TextBlock Classes="section" Text="{x:Static r:Strings.Section_Types}" />
                            <ItemsControl ItemsSource="{Binding Types}" />
                            <TextBlock Classes="section" Text="{x:Static r:Strings.Section_Abilities}" />
                            <ItemsControl ItemsSource="{Binding Abilities}" />
                            <TextBlock Classes="section" Text="{x:Static r:Strings.Section_Breeding}" />
                            <ItemsControl ItemsSource="{Binding Breeding}" />
                            <TextBlock Classes="hint" Margin="0,2,0,0" Text="{x:Static r:Strings.Gender_Hint}" />
                            <TextBlock Classes="section" Text="{x:Static r:Strings.Section_WildItems}" />
                            <ItemsControl ItemsSource="{Binding Items}" />
                          </StackPanel>
                        </WrapPanel>
                      </ScrollViewer>
                    </TabItem>

                    <TabItem>
                      <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="{x:Static r:Strings.Detail_LevelUp}" />
                          <TextBlock Classes="dot" Text="●" IsVisible="{Binding IsLearnsetModified}" />
                        </StackPanel>
                      </TabItem.Header>
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,8">
                          <Button Content="{x:Static r:Strings.LevelUp_Add}" Command="{Binding AddMoveCommand}" />
                          <Button Content="{x:Static r:Strings.LevelUp_Sort}" Command="{Binding SortLearnsetCommand}" />
                          <TextBlock Classes="hint" VerticalAlignment="Center" Text="{x:Static r:Strings.LevelUp_Hint}" />
                        </StackPanel>
                        <ScrollViewer>
                          <ItemsControl ItemsSource="{Binding Learnset}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:LearnsetRowViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                  <TextBlock Classes="field-label" Text="{x:Static r:Strings.LevelUp_Level}" />
                                  <NumericUpDown Value="{Binding Level}" Minimum="1" Maximum="100" Increment="1"
                                                 FormatString="0" ParsingNumberStyle="Integer" Width="130" />
                                  <ComboBox ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding SelectedMove}"
                                            Width="260" MaxDropDownHeight="360" />
                                  <Button Content="{x:Static r:Strings.Common_Remove}" Command="{Binding RemoveCommand}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </DockPanel>
                    </TabItem>
                  </TabControl>
                </DockPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Grid>
        </DockPanel>
      </TabItem>

      <!-- ================= Advanced: Moves ================= -->
      <TabItem Header="{x:Static r:Strings.Tab_AdvancedMoves}">
        <Grid ColumnDefinitions="300,*">
          <DockPanel Margin="8">
            <TextBox DockPanel.Dock="Top" Text="{Binding MoveFilter}" PlaceholderText="{x:Static r:Strings.Search_Watermark}" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Moves}" SelectedItem="{Binding SelectedMove}" />
          </DockPanel>

          <ContentControl Grid.Column="1" Content="{Binding MoveDetail}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:MoveDetailViewModel">
                <ScrollViewer Margin="8,8,12,8">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                      <Button Grid.Column="1" Content="{x:Static r:Strings.Detail_Revert}" Command="{Binding RevertCommand}" IsEnabled="{Binding IsModified}" />
                    </Grid>
                    <TextBlock Classes="section" Text="{x:Static r:Strings.Move_Main}" />
                    <ItemsControl ItemsSource="{Binding Main}" />
                    <TextBlock Classes="section" Text="{x:Static r:Strings.Move_Details}" />
                    <ItemsControl ItemsSource="{Binding Details}" />
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
