<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             xmlns:r="using:Pokemanager.App.Resources"
             xmlns:c="using:Pokemanager.App.Controls"
             x:Class="Pokemanager.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">

  <UserControl.Styles>
    <!-- Project list on a box wallpaper: the frame clips the picture, the list is see-through, each project a white card. -->
    <Style Selector="Border.projects-frame">
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ListBox.projects">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,8,8,4" />
    </Style>
    <Style Selector="ListBox.projects ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="ListBox.projects ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.projects ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.projects ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.projects ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.projects ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ListBox.projects ListBoxItem:selected TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <!-- The folded team: square icons on their type colours -->
    <Style Selector="Border.member.mini">
      <Setter Property="Width" Value="76" />
      <Setter Property="Height" Value="58" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Border.project-card">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.project-card">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.project-card">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.project-card.dragging">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- Open: the whole right side of the card, in the game's colour (2026-11-11, user) -->
    <Style Selector="Button.game-open">
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.game-open /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.game-open:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <!-- The bin below the list, in red (2026-11-11, user): drop a project on it to delete it -->
    <Style Selector="Border.trash">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
    </Style>
    <Style Selector="Border.trash TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Border.trash.drop">
      <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Border.trash.drop TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- A badge, a trial or the league: click an earned one to spin its roulette -->
    <DataTemplate x:Key="BadgeItem" x:DataType="vm:BadgeItemViewModel">
      <Panel Margin="0,0,6,0" ToolTip.Tip="{Binding Tooltip}">
        <Button Classes="badge" Classes.icon="{Binding HasIcon}" Classes.pending="{Binding IsPending}" Background="{Binding Background}"
                Command="{Binding SpinCommand}" IsEnabled="{Binding CanSpin}">
          <Panel>
            <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Opacity="{Binding IconOpacity}" Stretch="Uniform" />
            <TextBlock Text="{Binding Number}" FontSize="15" FontWeight="Bold" Foreground="{Binding Foreground}" IsVisible="{Binding !HasIcon}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </Button>
        <Border IsVisible="{Binding HasMark}" Width="17" Height="17" CornerRadius="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
          <TextBlock Text="{Binding Mark}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding MarkBrush}" />
        </Border>
      </Panel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <!-- ======================= Preview of a project: ROM and team, read only ======================= -->
    <DataTemplate DataType="vm:ProjectPreviewViewModel">
      <!-- One scroll for the whole right side (2026-11-11, user): ROM, trials and team move together. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8">
          <!-- ROM summary; Jugar big, Abrir proyecto and Pokédex below it, as wide together -->
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding GameText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="hint" Text="{Binding RomText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="hint" Text="{Binding RandomText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PlayStatus}" TextWrapping="Wrap" Classes.error="{Binding PlayFailed}"
                           IsVisible="{Binding PlayStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock.Styles>
                    <Style Selector="TextBlock.error">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    </Style>
                  </TextBlock.Styles>
                </TextBlock>
              </StackPanel>
              <Grid Grid.Column="1" Width="300" Margin="12,0,0,0" RowDefinitions="Auto,6,Auto" ColumnDefinitions="*,6,*" VerticalAlignment="Top">
                <Button Grid.ColumnSpan="3" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Content="{x:Static r:Strings.Editor_Play}" Command="{Binding PlayCommand}" ToolTip.Tip="{x:Static r:Strings.Editor_PlayTip}" />
                <Button Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Content="{x:Static r:Strings.Preview_Manage}" Command="{Binding ManageCommand}" ToolTip.Tip="{x:Static r:Strings.Preview_ManageTip}" />
                <Button Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Content="{x:Static r:Strings.Preview_Pokedex}" Command="{Binding OpenPokedexCommand}" ToolTip.Tip="{x:Static r:Strings.Preview_PokedexTip}" />
              </Grid>
            </Grid>
          </Border>

          <!-- Locke: badges or trials on the left (the big ones above, the captains' trials below), lives on the right -->
          <Border Classes="card" Classes.gameover="{Binding IsGameOver}">
            <Border.Styles>
              <Style Selector="Border.card.gameover">
                <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
              </Style>
              <Style Selector="Button.badge">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="#80FFFFFF" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
              </Style>
              <Style Selector="Button.badge:disabled">
                <Setter Property="Opacity" Value="1" />
              </Style>
              <Style Selector="Button.badge:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
                <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
              </Style>
              <Style Selector="Button.badge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
              </Style>
              <Style Selector="Button.badge:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Style>
              <Style Selector="Button.badge.icon">
                <Setter Property="Width" Value="72" />
                <Setter Property="Height" Value="72" />
                <Setter Property="BorderBrush" Value="Transparent" />
              </Style>
              <Style Selector="Button.badge Image">
                <Setter Property="Width" Value="64" />
                <Setter Property="Height" Value="64" />
              </Style>
              <!-- The captains' trials: smaller -->
              <Style Selector="ItemsControl.minor Button.badge">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
              </Style>
              <Style Selector="ItemsControl.minor Button.badge.icon">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
              </Style>
              <Style Selector="ItemsControl.minor Button.badge Image">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
              </Style>
              <Style Selector="Button.badge.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              </Style>
              <Style Selector="Button.badge.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              </Style>
              <Style Selector="Button.badge.pending">
                <Setter Property="BorderBrush" Value="{DynamicResource ModifiedBrush}" />
              </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <!-- Title row; the chevron folds the card up -->
              <DockPanel Grid.ColumnSpan="2">
                <Button DockPanel.Dock="Right" Classes="fold" Command="{Binding TrialsFold.ToggleCommand}" ToolTip.Tip="{Binding TrialsFold.Tip}">
                  <c:Chevron Angle="{Binding TrialsFold.Angle}" />
                </Button>
                <TextBlock DockPanel.Dock="Right" Classes="card-title" Margin="0,0,10,0" Text="{Binding LivesText}"
                           IsVisible="{Binding TrialsFold.IsFolded}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="card-title" VerticalAlignment="Center" Text="{Binding BadgesText}" />
                  <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="2" Padding="8,1"
                          IsVisible="{Binding HasLevelCap}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LevelCapText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                  </Border>
                </StackPanel>
              </DockPanel>

              <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding TrialsFold.IsOpen}">
                <ItemsControl ItemsSource="{Binding MajorBadges}" ItemTemplate="{StaticResource BadgeItem}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl Classes="minor" ItemsSource="{Binding MinorBadges}" ItemTemplate="{StaticResource BadgeItem}" IsVisible="{Binding HasMinorBadges}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>

              <!-- Lives: the right side only -->
              <Border Grid.Row="1" Grid.Column="1" Width="180" Margin="12,8,0,0" Padding="12,0,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0"
                      IsVisible="{Binding TrialsFold.IsOpen}">
                <StackPanel Spacing="6" IsVisible="{Binding TracksLives}">
                  <TextBlock Classes="card-title" Text="{Binding LivesText}" />
                  <TextBlock Text="{Binding Hearts}" FontSize="24" LineHeight="26" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{x:Static r:Strings.Locke_GameOver}" IsVisible="{Binding IsGameOver}" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" />
                  <Grid ColumnDefinitions="*,6,*">
                    <Button Content="−" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding LoseLifeCommand}" ToolTip.Tip="{x:Static r:Strings.Locke_LoseLife}" />
                    <Button Grid.Column="2" Content="+" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding GainLifeCommand}" ToolTip.Tip="{x:Static r:Strings.Locke_GainLife}" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- No save -->
          <TextBlock Classes="hint" Margin="4" Text="{Binding SaveMessage}" IsVisible="{Binding !HasSave}" TextWrapping="Wrap" />

          <!-- Team (2026-11-11, user): folded by default to a strip of icons beside the picked Pokémon; unfolded, the
               six cards in a row above it -->
          <StackPanel Spacing="8" IsVisible="{Binding HasSave}">
            <Border Classes="card" IsVisible="{Binding TeamFold.IsOpen}">
              <StackPanel Spacing="6">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="fold" Command="{Binding TeamFold.ToggleCommand}" ToolTip.Tip="{Binding TeamFold.Tip}">
                    <c:Chevron Angle="{Binding TeamFold.Angle}" />
                  </Button>
                  <TextBlock Classes="card-title" Text="{x:Static r:Strings.Preview_Team}" VerticalAlignment="Center" />
                  <TextBlock Classes="hint" Margin="10,0,0,0" Text="{Binding TrainerText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Party}" ItemTemplate="{StaticResource PartyCard}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <c:CardGrid MinColumnWidth="170" MaxColumns="6" Spacing="6" FillLastRow="False" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>

            <c:SidePanel MinMainWidth="480">
              <!-- Folded: the chevron and the party as icons on their type colours, with what they hold -->
              <Border Classes="card" Padding="6,8" VerticalAlignment="Top" IsVisible="{Binding TeamFold.IsFolded}">
                <StackPanel Spacing="6">
                  <Button Classes="fold" HorizontalAlignment="Center" Command="{Binding TeamFold.ToggleCommand}" ToolTip.Tip="{Binding TeamFold.Tip}">
                    <c:Chevron Angle="{Binding TeamFold.Angle}" />
                  </Button>
                  <ItemsControl ItemsSource="{Binding Party}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PartyMemberViewModel">
                        <Button Classes="plain" Padding="0" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Tooltip}">
                          <Border Classes="member mini" Classes.selected="{Binding IsSelected}" Background="{Binding TypeBackground}">
                            <Panel>
                              <Image Classes="sprite" Source="{Binding Icon}" Width="64" Height="48" RenderOptions.BitmapInterpolationMode="None" />
                              <TextBlock Text="🥚" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEgg}" />
                              <Image Source="{Binding ItemIcon}" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     RenderOptions.BitmapInterpolationMode="None" IsVisible="{Binding HasItem}" />
                            </Panel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Panel VerticalAlignment="Top">
                <TextBlock Classes="hint" Margin="4" Text="{x:Static r:Strings.Preview_ClickHint}" IsVisible="{Binding !HasSelection}" TextWrapping="Wrap" />
                <ContentControl Content="{Binding SelectedSheet}" ContentTemplate="{StaticResource MonSheet}" IsVisible="{Binding HasSelection}" />
              </Panel>
            </c:SidePanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel Margin="12,10,12,12">
    <!-- Header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="2,0,2,10">
      <TextBlock Text="Pokemanager" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="hint" Margin="14,0" VerticalAlignment="Center" Text="{x:Static r:Strings.Welcome_Subtitle}"
                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    </Grid>

    <Grid ColumnDefinitions="Auto,*">
      <!-- Folded: a thin strip with the chevron -->
      <Border Classes="card" Padding="4,8" Margin="0,0,10,0" VerticalAlignment="Stretch" IsVisible="{Binding RecentFold.IsFolded}">
        <Button Classes="fold" VerticalAlignment="Top" Command="{Binding RecentFold.ToggleCommand}" ToolTip.Tip="{Binding RecentFold.Tip}">
          <c:Chevron Angle="{Binding RecentFold.Angle}" />
        </Button>
      </Border>
      <DockPanel Width="360" Margin="0,0,10,0" IsVisible="{Binding RecentFold.IsOpen}">
      <!-- ======================= Multiplayer: profile and room ======================= -->
      <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,8,0,0">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <ContentControl Content="{Binding Room.Avatar}" Width="46" Height="46" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="card-title" Margin="0" Text="{x:Static r:Strings.Room_NoneTitle}" />
            <TextBlock Text="{Binding Room.ProfileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="hint" FontSize="11" Text="{Binding Room.SummaryText}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
            <Button Content="{x:Static r:Strings.Room_Open}" Command="{Binding OpenRoomCommand}" IsVisible="{Binding !ShowRoom}" />
            <Button Content="{x:Static r:Strings.Room_ClosePanel}" Command="{Binding CloseRoomPanelCommand}" IsVisible="{Binding ShowRoom}"
                    ToolTip.Tip="{x:Static r:Strings.Room_ClosePanelTip}" />
            <Button Content="{x:Static r:Strings.Welcome_Settings}" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{x:Static r:Strings.Tip_WelcomeSettings}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ======================= Project list ======================= -->
      <Border Classes="card">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Classes="fold" Command="{Binding RecentFold.ToggleCommand}" ToolTip.Tip="{Binding RecentFold.Tip}">
              <c:Chevron Angle="{Binding RecentFold.Angle}" />
            </Button>
            <TextBlock Classes="card-title" VerticalAlignment="Center" Text="{x:Static r:Strings.Welcome_Recent}" />
          </DockPanel>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,6,*" Margin="0,8,0,0">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="{x:Static r:Strings.Welcome_NewProjectButton}" Command="{Binding NewProjectCommand}" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="{x:Static r:Strings.Welcome_OpenExisting}" Command="{Binding OpenExistingCommand}" />
          </Grid>
          <Border DockPanel.Dock="Bottom" Classes="trash" Margin="0,8,0,0" ToolTip.Tip="{x:Static r:Strings.Welcome_TrashTip}"
                  IsVisible="{Binding HasRecentProjects}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="✕" FontWeight="Bold" />
              <TextBlock Text="{x:Static r:Strings.Welcome_TrashHint}" />
            </StackPanel>
          </Border>
          <TextBlock DockPanel.Dock="Bottom" Classes="error" Margin="0,6,0,0" Text="{Binding Error}"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <!-- The list sits on a box wallpaper of the selected project's game (2026-11-09, user); rows are white cards. -->
          <Border Classes="projects-frame">
            <Panel>
              <Image Source="{Binding ProjectsWallpaper}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border Classes="project-card" VerticalAlignment="Top" Margin="8" IsVisible="{Binding !HasRecentProjects}">
                <TextBlock Classes="hint" Text="{x:Static r:Strings.Welcome_NoProjects}" TextWrapping="Wrap" />
              </Border>
              <ListBox Classes="projects" ItemsSource="{Binding RecentProjects}" SelectedItem="{Binding SelectedProject}" IsVisible="{Binding HasRecentProjects}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RecentProjectItem">
                    <Border Classes="project-card" c:ProjectDrag.Enabled="True">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Margin="10,6,8,6" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="hint" Text="{Binding GameName}" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding GameName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Classes="hint" Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="game-open" Background="{Binding GameBrush}" Foreground="{Binding GameInk}"
                                Content="{x:Static r:Strings.Preview_Open}" Command="{Binding ManageCommand}" ToolTip.Tip="{x:Static r:Strings.Preview_ManageTip}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </Border>
        </DockPanel>
      </Border>
      </DockPanel>

      <!-- ======================= Right side: preview, new project or multiplayer ======================= -->
      <Grid Grid.Column="1">
        <DockPanel IsVisible="{Binding ShowRoom}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock Classes="card-title" VerticalAlignment="Center" Text="{x:Static r:Strings.Room_NoneTitle}" />
            <Button Grid.Column="1" Content="{x:Static r:Strings.Room_ClosePanel}" Command="{Binding CloseRoomPanelCommand}" ToolTip.Tip="{x:Static r:Strings.Room_ClosePanelTip}" />
          </Grid>
          <ContentControl Content="{Binding Room}" />
        </DockPanel>
        <Grid IsVisible="{Binding ShowPreviewArea}">
          <!-- The preview's shape while the project and its save are read -->
          <StackPanel Spacing="10" IsVisible="{Binding IsLoadingPreview}" ToolTip.Tip="{x:Static r:Strings.Preview_Loading}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="6">
                <Border Classes="skeleton" Width="260" Height="16" HorizontalAlignment="Left" />
                <Border Classes="skeleton" Width="200" Height="10" HorizontalAlignment="Left" />
                <Border Classes="skeleton" Width="160" Height="10" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <Border Classes="skeleton" Width="300" Height="36" />
                <Border Classes="skeleton" Width="300" Height="28" />
              </StackPanel>
            </Grid>
            <Border Classes="skeleton" Height="150" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="skeleton" Width="186" Height="50" />
              <Border Classes="skeleton" Width="186" Height="50" />
              <Border Classes="skeleton" Width="186" Height="50" />
            </StackPanel>
            <Border Classes="skeleton" Height="90" />
            <Grid ColumnDefinitions="*,10,*">
              <Border Classes="skeleton" Height="220" />
              <Border Grid.Column="2" Classes="skeleton" Height="220" />
            </Grid>
          </StackPanel>
          <TextBlock Classes="error" Margin="8" Text="{Binding PreviewError}"
                     IsVisible="{Binding PreviewError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="hint" Margin="8" Text="{x:Static r:Strings.Preview_SelectProject}"
                     IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNull}}" />
          <ContentControl Content="{Binding Preview}" IsVisible="{Binding HasPreview}" />
        </Grid>

        <Border Classes="card" IsVisible="{Binding ShowNewProject}" VerticalAlignment="Top">
          <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Classes="card-title" Text="{x:Static r:Strings.Welcome_NewProject}" />
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Welcome_NewProjectHint}" />
            <TextBlock Margin="0,6,0,0" Text="{x:Static r:Strings.Welcome_RomFile}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding RomPath}" PlaceholderText="D:\roms\Pokemon Ultra Moon.3ds" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Common_Browse}" Command="{Binding BrowseRomCommand}" />
            </Grid>
            <TextBlock Text="{Binding DetectedGame}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"
                       IsVisible="{Binding DetectedGame, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="hint" Foreground="{DynamicResource ModifiedTextBrush}" Text="{x:Static r:Strings.Welcome_RomRandomized}" IsVisible="{Binding RomLooksRandomized}" />
            <TextBlock Margin="0,8,0,0" Text="{x:Static r:Strings.Welcome_ProjectName}" />
            <TextBox Text="{Binding ProjectName}" MaxWidth="400" HorizontalAlignment="Left" MinWidth="300" />
            <TextBlock Classes="hint" Text="{Binding ProjectFileText}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{Binding GamesFolderText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
              <Button Classes="accent" Content="{x:Static r:Strings.Welcome_Create}" Command="{Binding CreateCommand}" />
              <ProgressBar IsIndeterminate="True" Width="100" IsVisible="{Binding IsCreating}" VerticalAlignment="Center" />
              <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding CreateStatus}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
