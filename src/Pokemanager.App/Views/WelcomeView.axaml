<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             xmlns:r="using:Pokemanager.App.Resources"
             x:Class="Pokemanager.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="720" Margin="32" Spacing="6" HorizontalAlignment="Center">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Pokemanager" FontSize="28" FontWeight="SemiBold" />
        <Button Grid.Column="1" Content="{x:Static r:Strings.Welcome_Settings}" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Classes="hint" Text="{x:Static r:Strings.Welcome_Subtitle}" />

      <StackPanel IsVisible="{Binding HasRecentProjects}" Spacing="4">
        <TextBlock Classes="section" Text="{x:Static r:Strings.Welcome_Recent}" />
        <ItemsControl ItemsSource="{Binding RecentProjects}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentProjectItem">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding OpenCommand}" Padding="10,6">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="hint" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Common_Remove}" VerticalAlignment="Center"
                        Command="{Binding ForgetCommand}" ToolTip.Tip="{x:Static r:Strings.Welcome_RemoveTip}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock Classes="section" Text="{x:Static r:Strings.Welcome_NewProject}" />

      <TextBlock Text="{x:Static r:Strings.Welcome_DumpFolder}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding DumpDirectory}" PlaceholderText="G:\pokemanager-dump" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Common_Browse}" Command="{Binding BrowseDumpCommand}" />
      </Grid>

      <TextBlock Margin="0,8,0,0" Text="{x:Static r:Strings.Welcome_GameLanguage}" />
      <ComboBox ItemsSource="{x:Static vm:WelcomeViewModel.Languages}" SelectedItem="{Binding Language}" MinWidth="220">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LanguageOption">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Margin="0,8,0,0" Text="{x:Static r:Strings.Welcome_ProjectFile}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding ProjectPath}" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Common_Browse}" Command="{Binding BrowseProjectCommand}" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
        <Button Classes="accent" Content="{x:Static r:Strings.Welcome_Create}" Command="{Binding CreateCommand}" />
        <Button Content="{x:Static r:Strings.Welcome_OpenExisting}" Command="{Binding OpenExistingCommand}" />
      </StackPanel>

      <TextBlock Classes="error" Margin="0,12,0,0" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
