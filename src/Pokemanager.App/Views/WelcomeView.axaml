<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             xmlns:r="using:Pokemanager.App.Resources"
             xmlns:c="using:Pokemanager.App.Controls"
             x:Class="Pokemanager.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">

  <UserControl.DataTemplates>
    <!-- ======================= Preview of a project: ROM and team, read only ======================= -->
    <DataTemplate DataType="vm:ProjectPreviewViewModel">
      <DockPanel>
        <!-- ROM summary -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding GameText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="hint" Text="{Binding RomText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="hint" Text="{Binding RandomText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Classes="accent" VerticalAlignment="Top" Padding="16,6" Content="{x:Static r:Strings.Preview_Manage}"
                    Command="{Binding ManageCommand}" ToolTip.Tip="{x:Static r:Strings.Preview_ManageTip}" />
          </Grid>
        </Border>

        <!-- Locke: badges from the save (click an earned one to spin its roulette) and lives -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8" Classes.gameover="{Binding IsGameOver}">
          <Border.Styles>
            <Style Selector="Border.card.gameover">
              <Setter Property="Background" Value="#FDECEC" />
              <Setter Property="BorderBrush" Value="#D13438" />
            </Style>
            <Style Selector="Button.badge">
              <Setter Property="Width" Value="42" />
              <Setter Property="Height" Value="42" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="CornerRadius" Value="2" />
              <Setter Property="BorderThickness" Value="2" />
              <Setter Property="BorderBrush" Value="#80FFFFFF" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="Button.badge:disabled">
              <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="Button.badge:disabled /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
              <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
            </Style>
            <Style Selector="Button.badge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
              <Setter Property="BorderBrush" Value="#1C3A70" />
            </Style>
            <Style Selector="Button.badge:pressed /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
              <Setter Property="BorderBrush" Value="#0B1E40" />
            </Style>
            <!-- With the game's badge image: no circle, only a frame on hover or when a prize is pending -->
            <Style Selector="Button.badge.icon">
              <Setter Property="Width" Value="52" />
              <Setter Property="Height" Value="52" />
              <Setter Property="CornerRadius" Value="2" />
              <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <Style Selector="Button.badge.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="#E3EEFA" />
            </Style>
            <Style Selector="Button.badge.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="#CCE0F5" />
            </Style>
            <Style Selector="Button.badge.pending">
              <Setter Property="BorderBrush" Value="#E07B00" />
            </Style>
          </Border.Styles>
          <WrapPanel>
            <StackPanel Spacing="4" Margin="0,0,24,0">
              <TextBlock Classes="card-title" Text="{Binding BadgesText}" />
              <ItemsControl ItemsSource="{Binding Badges}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BadgeItemViewModel">
                    <Panel Margin="0,0,6,0" ToolTip.Tip="{Binding Tooltip}">
                      <Button Classes="badge" Classes.icon="{Binding HasIcon}" Classes.pending="{Binding IsPending}" Background="{Binding Background}"
                              Command="{Binding SpinCommand}" IsEnabled="{Binding CanSpin}">
                        <Panel>
                          <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Opacity="{Binding IconOpacity}" Width="44" Height="44" Stretch="Uniform" />
                          <TextBlock Text="{Binding Number}" FontSize="15" FontWeight="Bold" Foreground="{Binding Foreground}" IsVisible="{Binding !HasIcon}" />
                        </Panel>
                      </Button>
                      <Border IsVisible="{Binding HasMark}" Width="17" Height="17" CornerRadius="2" Background="White"
                              BorderBrush="#9A9A9A" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                        <TextBlock Text="{Binding Mark}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding MarkBrush}" />
                      </Border>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding TracksLives}">
              <TextBlock Classes="card-title" Text="{Binding LivesText}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Hearts}" FontSize="26" Foreground="#D13438" VerticalAlignment="Center" />
                <Button Content="−" Width="26" Padding="0" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding LoseLifeCommand}" ToolTip.Tip="{x:Static r:Strings.Locke_LoseLife}" />
                <Button Content="+" Width="26" Padding="0" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding GainLifeCommand}" ToolTip.Tip="{x:Static r:Strings.Locke_GainLife}" />
                <TextBlock Text="{x:Static r:Strings.Locke_GameOver}" IsVisible="{Binding IsGameOver}" FontWeight="Bold" Foreground="#D13438" VerticalAlignment="Center" Margin="6,0,0,0" />
              </StackPanel>
            </StackPanel>
          </WrapPanel>
        </Border>

        <!-- No save -->
        <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="4" Text="{Binding SaveMessage}" IsVisible="{Binding !HasSave}" TextWrapping="Wrap" />

        <!-- Team: the save editor's party cards -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8" IsVisible="{Binding HasSave}">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="card-title" Text="{x:Static r:Strings.Preview_Team}" />
              <TextBlock Grid.Column="1" Classes="hint" Margin="10,0,0,0" Text="{Binding TrainerText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Party}" ItemTemplate="{StaticResource PartyCard}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Preview_ClickHint}" IsVisible="{Binding !HasSelection}" />
          </StackPanel>
        </Border>

        <!-- Selected Pokémon, laid out as in the save editor -->
        <ScrollViewer IsVisible="{Binding HasSelection}">
          <ContentControl Content="{Binding SelectedSheet}" ContentTemplate="{StaticResource MonSheet}" />
        </ScrollViewer>
      </DockPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel Margin="12,10,12,12">
    <!-- Header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="2,0,2,10">
      <TextBlock Text="Pokemanager" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="hint" Margin="14,0" VerticalAlignment="Center" Text="{x:Static r:Strings.Welcome_Subtitle}"
                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      <Button Grid.Column="2" Content="{x:Static r:Strings.Welcome_Settings}" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" />
    </Grid>

    <Grid ColumnDefinitions="360,*">
      <DockPanel Margin="0,0,10,0">
      <!-- ======================= Multiplayer: profile and room ======================= -->
      <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,8,0,0">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <ContentControl Content="{Binding Room.Avatar}" Width="46" Height="46" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="card-title" Margin="0" Text="{x:Static r:Strings.Room_NoneTitle}" />
            <TextBlock Text="{Binding Room.ProfileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="hint" FontSize="11" Text="{Binding Room.SummaryText}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
            <Button Classes="accent" Content="{x:Static r:Strings.Room_Open}" Command="{Binding OpenRoomCommand}" IsVisible="{Binding !ShowRoom}" />
            <Button Content="{x:Static r:Strings.Room_ClosePanel}" Command="{Binding CloseRoomPanelCommand}" IsVisible="{Binding ShowRoom}"
                    ToolTip.Tip="{x:Static r:Strings.Room_ClosePanelTip}" />
            <Button Content="{x:Static r:Strings.Room_EditProfile}" Command="{Binding OpenSettingsCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ======================= Project list ======================= -->
      <Border Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="card-title" Margin="0,0,0,6" Text="{x:Static r:Strings.Welcome_Recent}" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
            <Button Content="{x:Static r:Strings.Welcome_NewProjectButton}" Command="{Binding NewProjectCommand}" />
            <Button Content="{x:Static r:Strings.Welcome_OpenExisting}" Command="{Binding OpenExistingCommand}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Classes="error" Margin="0,6,0,0" Text="{Binding Error}"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Grid>
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Welcome_NoProjects}" IsVisible="{Binding !HasRecentProjects}" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding RecentProjects}" SelectedItem="{Binding SelectedProject}" IsVisible="{Binding HasRecentProjects}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentProjectItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="hint" Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0" VerticalAlignment="Center">
                      <Button Content="{x:Static r:Strings.Preview_Manage}" Command="{Binding ManageCommand}" ToolTip.Tip="{x:Static r:Strings.Preview_ManageTip}" />
                      <Button Content="✕" Padding="6,2" Command="{Binding ForgetCommand}" ToolTip.Tip="{x:Static r:Strings.Welcome_RemoveTip}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </DockPanel>
      </Border>
      </DockPanel>

      <!-- ======================= Right side: preview, new project or multiplayer ======================= -->
      <Grid Grid.Column="1">
        <DockPanel IsVisible="{Binding ShowRoom}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock Classes="card-title" VerticalAlignment="Center" Text="{x:Static r:Strings.Room_NoneTitle}" />
            <Button Grid.Column="1" Content="{x:Static r:Strings.Room_ClosePanel}" Command="{Binding CloseRoomPanelCommand}" ToolTip.Tip="{x:Static r:Strings.Room_ClosePanelTip}" />
          </Grid>
          <ContentControl Content="{Binding Room}" />
        </DockPanel>
        <Grid IsVisible="{Binding ShowPreviewArea}">
          <TextBlock Classes="hint" Margin="8" Text="{x:Static r:Strings.Preview_Loading}" IsVisible="{Binding IsLoadingPreview}" />
          <TextBlock Classes="error" Margin="8" Text="{Binding PreviewError}"
                     IsVisible="{Binding PreviewError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="hint" Margin="8" Text="{x:Static r:Strings.Preview_SelectProject}"
                     IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNull}}" />
          <ContentControl Content="{Binding Preview}" IsVisible="{Binding HasPreview}" />
        </Grid>

        <Border Classes="card" IsVisible="{Binding ShowNewProject}" VerticalAlignment="Top">
          <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Classes="card-title" Text="{x:Static r:Strings.Welcome_NewProject}" />
            <TextBlock Classes="hint" Text="{x:Static r:Strings.Welcome_NewProjectHint}" />
            <TextBlock Margin="0,6,0,0" Text="{x:Static r:Strings.Welcome_RomFile}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding RomPath}" PlaceholderText="D:\roms\Pokemon Ultra Moon.3ds" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="{x:Static r:Strings.Common_Browse}" Command="{Binding BrowseRomCommand}" />
            </Grid>
            <TextBlock Text="{Binding DetectedGame}" FontWeight="SemiBold" Foreground="#2E8B57"
                       IsVisible="{Binding DetectedGame, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="hint" Foreground="#B35C00" Text="{x:Static r:Strings.Welcome_RomRandomized}" IsVisible="{Binding RomLooksRandomized}" />
            <TextBlock Margin="0,8,0,0" Text="{x:Static r:Strings.Welcome_ProjectName}" />
            <TextBox Text="{Binding ProjectName}" MaxWidth="400" HorizontalAlignment="Left" MinWidth="300" />
            <TextBlock Classes="hint" Text="{Binding ProjectFileText}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{Binding GamesFolderText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
              <Button Classes="accent" Content="{x:Static r:Strings.Welcome_Create}" Command="{Binding CreateCommand}" />
              <ProgressBar IsIndeterminate="True" Width="100" IsVisible="{Binding IsCreating}" VerticalAlignment="Center" />
              <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding CreateStatus}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
