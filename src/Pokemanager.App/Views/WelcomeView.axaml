<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             x:Class="Pokemanager.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="720" Margin="32" Spacing="6" HorizontalAlignment="Center">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Pokemanager" FontSize="28" FontWeight="SemiBold" />
        <Button Grid.Column="1" Content="Ajustes…" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Classes="hint" Text="Randomizer y editor de partida para Pokémon X/Y. Tu ROM base nunca se modifica: las ROM randomizadas se crean como archivos nuevos a su lado." />

      <TextBlock Classes="section" Text="Nuevo proyecto" />

      <TextBlock Text="Carpeta del volcado (con el .3ds y sus carpetas romfs y exefs, con code.bin descomprimido)" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding DumpDirectory}" Watermark="G:\pokemanager-dump" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="Examinar…" Command="{Binding BrowseDumpCommand}" />
      </Grid>

      <TextBlock Margin="0,8,0,0" Text="Idioma de los textos del juego" />
      <ComboBox ItemsSource="{x:Static vm:WelcomeViewModel.Languages}" SelectedItem="{Binding Language}" MinWidth="220">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LanguageOption">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Margin="0,8,0,0" Text="Archivo del proyecto" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding ProjectPath}" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="Examinar…" Command="{Binding BrowseProjectCommand}" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
        <Button Classes="accent" Content="Crear proyecto" Command="{Binding CreateCommand}" />
        <Button Content="Abrir proyecto existente…" Command="{Binding OpenExistingCommand}" />
      </StackPanel>

      <TextBlock Classes="error" Margin="0,12,0,0" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
