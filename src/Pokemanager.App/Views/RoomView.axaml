<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pokemanager.App.ViewModels"
             xmlns:r="using:Pokemanager.App.Resources"
             xmlns:c="using:Pokemanager.App.Controls"
             x:Class="Pokemanager.App.Views.RoomView"
             x:DataType="vm:RoomViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Party cards, box and Pokémon sheet: shared with the save editor (Styles/PokemonLook.axaml) -->
  </UserControl.Styles>

  <Grid>
    <!-- ================= Not in a room ================= -->
    <ScrollViewer IsVisible="{Binding NoSession}">
      <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left">
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*">
            <ContentControl Content="{Binding Avatar}" Width="64" Height="64" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{x:Static r:Strings.Room_NoneTitle}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" />
              <TextBlock Classes="hint" Text="{x:Static r:Strings.Room_NoneHint}" />
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Text="{Binding SelectedProjectText}" FontWeight="SemiBold" Margin="4,0" TextWrapping="Wrap" />

        <Border Classes="card" IsVisible="{Binding CanResume}">
          <StackPanel Spacing="6">
            <TextBlock Classes="card-title" Text="{x:Static r:Strings.Room_ResumeTitle}" />
            <Button Classes="accent" Content="{Binding ResumeText}" Command="{Binding ResumeCommand}" />
          </StackPanel>
        </Border>

        <c:AdaptiveColumnsPanel MinColumnWidth="330" MaxColumns="2" Spacing="8">
          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Classes="card-title" Text="{x:Static r:Strings.Room_CreateTitle}" />
              <TextBlock Classes="hint" Text="{x:Static r:Strings.Room_CreateHint}" />
              <TextBox Text="{Binding RoomName}" PlaceholderText="{x:Static r:Strings.Room_NamePlaceholder}" />
              <Button Classes="accent" Content="{x:Static r:Strings.Room_Create}" Command="{Binding CreateCommand}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Classes="card-title" Text="{x:Static r:Strings.Room_JoinTitle}" />
              <TextBlock Classes="hint" Text="{x:Static r:Strings.Room_JoinHint}" />
              <TextBox Classes="code" Text="{Binding JoinCode}" PlaceholderText="PM-…" />
              <Button Content="{x:Static r:Strings.Room_Join}" Command="{Binding JoinCommand}" />
            </StackPanel>
          </Border>
        </c:AdaptiveColumnsPanel>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes.error="{Binding MessageIsError}" Margin="4,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- ================= In a room ================= -->
    <DockPanel IsVisible="{Binding HasSession}">
      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock>
                <Run Text="●" Foreground="{Binding StatusBrush}" />
                <Run Text="{Binding StatusText}" />
              </TextBlock>
              <TextBlock Classes="hint" Text="{Binding ReachText}" />
              <TextBlock Classes="hint">
                <Run Text="{Binding SharedProjectText}" />
                <Run Text=" " />
                <Run Text="{Binding SharedText}" />
              </TextBlock>
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes.error="{Binding MessageIsError}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
              <Button Content="{x:Static r:Strings.Room_ShareNow}" Command="{Binding ShareNowCommand}" ToolTip.Tip="{x:Static r:Strings.Room_ShareNowTip}" />
              <Button Content="{x:Static r:Strings.Room_Leave}" Command="{Binding LeaveCommand}" />
            </StackPanel>
          </Grid>

          <!-- Host: invite code, answers and rules -->
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsHost}">
            <StackPanel Spacing="4">
              <TextBlock Classes="hint" Text="{x:Static r:Strings.Room_InviteHint}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Classes="code" Text="{Binding InviteText}" IsReadOnly="True" Margin="0,0,6,0" />
                <Button Grid.Column="1" Content="{x:Static r:Strings.Room_Copy}" Click="CopyInvite" VerticalAlignment="Top" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Classes="code" Text="{Binding AnswerInput}" PlaceholderText="{x:Static r:Strings.Room_AnswerPlaceholder}" Margin="0,0,6,0" />
                <Button Grid.Column="1" Content="{x:Static r:Strings.Room_AcceptAnswer}" Command="{Binding AcceptAnswerCommand}" VerticalAlignment="Top" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2">
              <TextBlock Classes="card-title" Text="{x:Static r:Strings.Room_RulesTitle}" />
              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_RoomShareParty}" Content="{x:Static r:Strings.Room_ShareParty}" IsChecked="{Binding ShareParty}" />
              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_RoomShareBoxes}" Content="{x:Static r:Strings.Room_ShareBoxes}" IsChecked="{Binding ShareBoxes}" />
            </StackPanel>
          </Grid>

          <!-- Guest: answer code when the direct way failed -->
          <StackPanel Spacing="4" IsVisible="{Binding ShowAnswer}">
            <TextBlock Classes="error" Text="{x:Static r:Strings.Room_AnswerHint}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Classes="code" Text="{Binding AnswerText}" IsReadOnly="True" Margin="0,0,6,0" />
              <Button Grid.Column="1" Content="{x:Static r:Strings.Room_Copy}" Click="CopyAnswer" VerticalAlignment="Top" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="230,*">
        <!-- Players -->
        <Border Classes="card" Margin="0,0,8,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="card-title" Text="{x:Static r:Strings.Room_PlayersTitle}" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RoomPlayerRow">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,3" Opacity="{Binding Faded}">
                    <ContentControl Content="{Binding Avatar}" Width="40" Height="40" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="●" Foreground="{Binding OnlineBrush}" />
                        <Run Text="{Binding Name}" FontWeight="SemiBold" />
                      </TextBlock>
                      <TextBlock Opacity="0.75" FontSize="11" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- Selected player -->
        <ScrollViewer Grid.Column="1">
          <StackPanel Spacing="8">
            <!-- Battles: challenge, rules before the battle, ready with the party, battle screen -->
            <Border Classes="card">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="card-title" Text="{x:Static r:Strings.Battle_Title}" />
                    <TextBlock Classes="hint" Text="{x:Static r:Strings.Battle_Hint}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="accent" Margin="12,0,0,0" VerticalAlignment="Top"
                          Content="{Binding ChallengeText}" Command="{Binding ChallengeCommand}" IsEnabled="{Binding CanChallenge}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding BattleCards}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoomBattleCard">
                      <Border BorderBrush="#40000000" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,4,0,0">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <ContentControl Content="{Binding OpponentAvatar}" Width="40" Height="40" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Classes="hint" Text="{Binding ReadyText}" IsVisible="{Binding IsProposed}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                              <Button Classes="accent" Content="{x:Static r:Strings.Battle_Open}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                              <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsVisible="{Binding !IsOver}" />
                              <Button Content="{x:Static r:Strings.Battle_Dismiss}" Command="{Binding DismissCommand}" IsVisible="{Binding IsOver}" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Classes="error" Text="{Binding ProblemsText}" IsVisible="{Binding HasProblems}" TextWrapping="Wrap" />

                          <StackPanel Spacing="6" IsVisible="{Binding IsProposed}">
                            <WrapPanel>
                              <StackPanel Margin="0,0,16,4" Spacing="2">
                                <TextBlock Classes="hint" Text="{x:Static r:Strings.Battle_Generation}" />
                                <ComboBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleGeneration}" SelectedIndex="{Binding GenerationIndex}" Width="220">
                                  <ComboBoxItem Content="{x:Static r:Strings.Battle_Gen6}" />
                                  <ComboBoxItem Content="{x:Static r:Strings.Battle_Gen7}" />
                                </ComboBox>
                              </StackPanel>
                              <StackPanel Margin="0,0,16,4" Spacing="2">
                                <TextBlock Classes="hint" Text="{x:Static r:Strings.Battle_Level}" />
                                <ComboBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleLevel}" SelectedIndex="{Binding LevelIndex}" Width="180">
                                  <ComboBoxItem Content="{x:Static r:Strings.Battle_LevelSave}" />
                                  <ComboBoxItem Content="{x:Static r:Strings.Battle_Level50}" />
                                  <ComboBoxItem Content="{x:Static r:Strings.Battle_Level100}" />
                                </ComboBox>
                              </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleHealBefore}" Margin="0,0,14,0" Content="{x:Static r:Strings.Battle_HealBefore}" IsChecked="{Binding HealBefore}" />
                              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleTeamPreview}" Margin="0,0,14,0" Content="{x:Static r:Strings.Battle_TeamPreview}" IsChecked="{Binding TeamPreview}" />
                              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleSleepClause}" Margin="0,0,14,0" Content="{x:Static r:Strings.Battle_SleepClause}" IsChecked="{Binding SleepClause}" />
                              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleSpeciesClause}" Margin="0,0,14,0" Content="{x:Static r:Strings.Battle_SpeciesClause}" IsChecked="{Binding SpeciesClause}" />
                              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleItemClause}" Margin="0,0,14,0" Content="{x:Static r:Strings.Battle_ItemClause}" IsChecked="{Binding ItemClause}" />
                              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleOhkoClause}" Margin="0,0,14,0" Content="{x:Static r:Strings.Battle_OhkoClause}" IsChecked="{Binding OhkoClause}" />
                              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleEvasionClause}" Margin="0,0,14,0" Content="{x:Static r:Strings.Battle_EvasionClause}" IsChecked="{Binding EvasionClause}" />
                              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleBatonPassClause}" Margin="0,0,14,0" Content="{x:Static r:Strings.Battle_BatonPassClause}" IsChecked="{Binding BatonPassClause}" />
                              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleNoMegas}" Margin="0,0,14,0" Content="{x:Static r:Strings.Battle_NoMegas}" IsChecked="{Binding NoMegas}" />
                              <CheckBox ToolTip.Tip="{x:Static r:Strings.Tip_BattleNoZMoves}" Margin="0,0,14,0" Content="{x:Static r:Strings.Battle_NoZMoves}" IsChecked="{Binding NoZMoves}" />
                            </WrapPanel>
                            <TextBlock Classes="hint" Text="{x:Static r:Strings.Battle_RulesHint}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Button Classes="accent" Content="{x:Static r:Strings.Battle_Ready}" Command="{Binding ReadyCommand}" IsVisible="{Binding IAmNotReady}" />
                              <Button Content="{x:Static r:Strings.Battle_Unready}" Command="{Binding NotReadyCommand}" IsVisible="{Binding IAmReady}" />
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- In-game link through the emulator's room server -->
            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="card-title" Text="{x:Static r:Strings.Emu_Title}" />
                <TextBlock Classes="hint" Text="{x:Static r:Strings.Emu_Hint}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EmulatorRoomText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Classes="hint" Text="{Binding EmulatorDirectConnectText}" IsVisible="{Binding EmulatorRoomOpen}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="accent" Content="{x:Static r:Strings.Emu_Play}" Command="{Binding PlayInEmulatorRoomCommand}" IsVisible="{Binding EmulatorRoomOpen}" />
                  <Button Content="{x:Static r:Strings.Emu_Open}" Command="{Binding OpenEmulatorRoomCommand}" IsVisible="{Binding CanOpenEmulatorRoom}" />
                  <Button Content="{x:Static r:Strings.Emu_Close}" Command="{Binding CloseEmulatorRoomCommand}" IsVisible="{Binding CanCloseEmulatorRoom}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding SelectedPlayer, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Grid ColumnDefinitions="Auto,*">
                <ContentControl Content="{Binding ShownAvatar}" Width="56" Height="56" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding ShownName}" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Classes="hint" Text="{Binding TrainerText}" IsVisible="{Binding HasPlayerData}" TextWrapping="Wrap" />
                  <TextBlock Classes="hint" Text="{x:Static r:Strings.Room_NoSaveYet}" IsVisible="{Binding NoPlayerData}" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- Party: the save editor's party cards -->
            <Border Classes="card" IsVisible="{Binding HasPlayerData}">
              <StackPanel Spacing="4">
                <TextBlock Classes="card-title" Text="{x:Static r:Strings.Preview_Team}" />
                <TextBlock Classes="hint" Text="{x:Static r:Strings.Room_PartyHidden}" IsVisible="{Binding PartyHidden}" />
                <ItemsControl ItemsSource="{Binding Party}" ItemTemplate="{StaticResource PartyCard}" IsVisible="{Binding HasParty}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Selected Pokémon, laid out as in the save editor -->
            <ContentControl Content="{Binding Detail}" ContentTemplate="{StaticResource MonSheet}" IsVisible="{Binding HasDetail}" />

            <!-- Boxes: the save editor's box browser -->
            <Border Classes="card" IsVisible="{Binding HasPlayerData}">
              <StackPanel Spacing="4">
                <TextBlock Classes="card-title" Text="{x:Static r:Strings.Room_BoxesTitle}" />
                <TextBlock Classes="hint" Text="{x:Static r:Strings.Room_BoxesHidden}" IsVisible="{Binding BoxesHidden}" />
                <c:BoxBrowser IsVisible="{Binding HasBoxes}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
