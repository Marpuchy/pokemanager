<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Pokemanager.Formats</AssemblyName>
    <!-- The pk3DS namespace is kept to avoid conflicts when merging upstream. -->
    <RootNamespace>pk3DS.Core</RootNamespace>
  </PropertyGroup>

  <!--
    Excluded from compilation: depends on System.Drawing (Windows only) or on the native
    ETC1Lib.dll. Graphics code, out of scope. The files stay to avoid upstream merge conflicts.
  -->
  <ItemGroup>
    <Compile Remove="ImageUtil.cs" />
    <Compile Remove="CTR/ETC1.cs" />
    <Compile Remove="CTR/SMDH.cs" />
    <Compile Remove="CTR/Images/**" />
    <Compile Remove="Structures/TypeChart.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
